#!/usr/bin/env bash
# ai-arena: run the same task through several AI candidates in parallel, each in
# its own worktree environment, gate them mechanically, judge them blind, promote
# the winner. Runs ON THE HOST from a coordinator project directory:
#
#   <project>/
#   ├── .ddev/            coordinator DDEV project (AI containers only, no Drupal)
#   ├── arena/<slug>/     arena state: manifest, brief, PM sessions, collected candidates
#   ├── main/             main environment (.ddev/ + <repo>/), never touched
#   ├── worktree/         real branch environments (promote --env creates one here)
#   └── worktree-tmp/     candidates (created by spawn, deleted by clean)
#
# Every LLM step runs inside AI containers (the coordinator's for the project
# manager, each candidate's own for the work) through docker exec. Every mechanical
# step is a deterministic subcommand, so the host agent picks verbs and reads JSON.
# Only worktree-tmp/ environments and tmp/* branches are ever deleted.
set -euo pipefail
shopt -u patsub_replacement 2>/dev/null || true

VERSION="0.4.0"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROMPTS_DIR="$SCRIPT_DIR/../prompts"
CONTAINER_ROOT="/var/www/html"
WINS_LOG="${HOME}/.ddev/ai-arena/wins.tsv"
GLOBAL_CONFIG="${HOME}/.ddev/ai-arena/config.env"
# What a reviewer is told about the site it can use ({{RUNTIME}} in prompts/review.md).
REVIEW_OFFLINE="You have no running Drupal and cannot run drush or tests; say what you would have run."
REVIEW_LIVE="This environment runs the site of the code under review, with its own database: use it. Run the tests the change touches and the live verification of the brief, query with \`ssh web drush ...\`, open the pages, and confirm or refute each finding by running it; paste the command and its output beside the finding. Never change code, config or modules (no cim, cex, en, pmu, updb, cr is fine); name any content you create for a probe with the prefix arena-review- and delete it when done. Another reviewer may be using the same site at the same time."

# ---------------------------------------------------------------------------
# Defaults, then ~/.ddev/ai-arena/config.env, then <project>/ai-arena.env
# ---------------------------------------------------------------------------
AI_ARENA_DEFAULT_CANDIDATES="claude,opencode"
AI_ARENA_PM_HARNESS="claude"
AI_ARENA_PM_MODEL=""
AI_ARENA_MAX_CANDIDATES=3
AI_ARENA_TIMEOUT=7200
AI_ARENA_WAIT_TIMEOUT=0
AI_ARENA_BASE_REF=""
AI_ARENA_DB="auto"
AI_ARENA_LOCAL_FILES=""
AI_ARENA_MAIN_ENV=""
AI_ARENA_REVIEWERS="claude:opus,opencode"
AI_ARENA_PLAN_BY="candidates"
AI_ARENA_DEADLINE_FACTOR=2
AI_ARENA_CANDIDATE_REVIEWS=1
# Harnesses that implement in a fresh session instead of resuming their planning session
# (space or comma separated). OpenCode compacts a long planning context early and can fail
# when a compaction does not fit; a fresh session reads its own plan file instead.
AI_ARENA_RUN_FRESH="opencode"
# Automatic continues per candidate and phase when a harness ends cleanly (exit 0) without a
# report: after an automatic compaction a model can take the summary for an order to stop.
AI_ARENA_AUTO_CONTINUE=1
AI_ARENA_AGENTS_REPO="https://github.com/trebormc/drupal-ai-agents.git"

log()  { printf '==> %s\n' "$*" >&2; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required on the host PATH"; }
now()  { date -u +%Y-%m-%dT%H:%M:%SZ; }

# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<EOF
ai-arena $VERSION — parallel AI candidates in isolated worktree environments

Usage: ai-arena [--project <dir>] <command> [args]      (default project: current directory)

  doctor                                   Check host tools, layout, coordinator containers
  up                                       Start the coordinator project's containers
  init "<task>" [--candidates a,b] [--pm harness[:model]] [--description "..."]
       [--approaches | --approach "..." ...] [--plan-by pm|candidates]
                                           Create arena/<slug>/manifest.json. A candidate is
                                           harness[:model][@agents] where @agents pins the agents
                                           repo (a branch of the default repo, or url#ref) to
                                           evaluate a change to the agents pack.
                                           APPROACHES MODE: same task, one prescribed approach
                                           per label (usually the same model for all, e.g.
                                           --candidates opencode,opencode). --approach "text"
                                           (one per label, in order) dictates them; --approaches
                                           lets the PM propose them in "plan" for your confirmation
  plan <slug> ["description"]              PM session writes arena/<slug>/brief.md
  draft <slug> [label...]                  --plan-by candidates: each candidate writes its own plan
  merge <slug>                             --plan-by candidates: PM picks the best plan, improves it
                                           with the others and writes arena/<slug>/brief.md
  spawn <slug> [label...]                  Create candidate environments (worktree-add --tmp)
  run <slug> [label...]                    Start candidates (detached) on the brief; planners resume
                                           their session, except harnesses in AI_ARENA_RUN_FRESH
                                           (opencode), which start fresh and read their own plan
  wait <slug> [--all] [--timeout S] [--interval S]
                                           Block until a candidate changes state (or all finish);
                                           no timeout by default (AI_ARENA_WAIT_TIMEOUT=0). Once one
                                           candidate finishes a phase DONE, the others get
                                           AI_ARENA_DEADLINE_FACTOR (2) times its time, then are stopped;
                                           each finished implementation is reviewed meanwhile, in its
                                           own environment, by a fresh session of its own harness and
                                           by the other candidates' harnesses
  stop <slug> <label...>                   Kill a running candidate's harness and settle its state
                                           from the report it has written so far
  status <slug> [--json]                   Show candidate states
  resume <slug> <label> "<message>"        Continue a candidate's session with a message
  pm <slug> "<message>"                    Send a message to the PM session, print its verdict
  gate <slug> [label...]                   Mechanical gates (site, config, phpstan, phpcs, phpunit,
                                           report: FILES in the report and the changed files match both ways)
  collect <slug>                           Gather diffs, reports and gates into arena/<slug>/candidates/
  compare <slug> [--json]                  Per-round time, steps, tokens and cost, tests and gates, by label
  judge <slug>                             PM judges the collected candidates (blind)
  promote <slug> <label> [--branch name] [--env] [--allow-undeclared]
                                           feature/<slug> from the winner (optionally its environment);
                                           refuses files the winner's report does not declare
  graft <slug> [--message "..."]           Port the judge's grafts into the promoted environment
                                           (promote --env first) and gate the result
  reveal <slug>                            Label -> harness/model, log the win
  clean <slug> [--keep label] [--purge]    Delete candidate environments and tmp/ branches (the winner's
                                           tmp/ branch too, once the promoted branch contains it)
  list                                     Arenas in this project
  review (--arena <slug> | --branch <b> | --env <dir> | --patch <file>) [--reviewers a,b] [--intent "..."] [--timeout S]
                                           Multi-model review of one diff: independent reviewers, then a lead synthesis.
                                           An environment is reviewed inside it, with its site, when its AI containers run.
                                           --arena reviews the arena's final code with a fresh session of the harness that
                                           wrote it plus the other candidates' harnesses, and after a fix checks the
                                           previous Act-on list and what changed

Config: ~/.ddev/ai-arena/config.env (all projects), <project>/ai-arena.env (this project)
EOF
}

# ---------------------------------------------------------------------------
# Project (coordinator) resolution
# ---------------------------------------------------------------------------
resolve_project() {
  PROJECT="$(cd "${PROJECT:-$PWD}" && pwd)"
  [ -f "$PROJECT/.ddev/config.yaml" ] || die "$PROJECT is not a DDEV project (no .ddev/config.yaml); run from the coordinator directory or pass --project"
  # shellcheck disable=SC1090
  [ -f "$GLOBAL_CONFIG" ] && { set -a; . "$GLOBAL_CONFIG"; set +a; }
  # shellcheck disable=SC1090
  [ -f "$PROJECT/ai-arena.env" ] && { set -a; . "$PROJECT/ai-arena.env"; set +a; }
  COORD="$(sed -nE 's/^name:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/p' "$PROJECT/.ddev/config.yaml" | head -n1 || true)"
  [ -n "$COORD" ] || COORD="$(basename "$PROJECT")"
  locate_main_env "$PROJECT"      # MAIN_ENV, REPO_REL, REPO_DIR, BASE
  case "$MAIN_ENV" in "$PROJECT"/*) MAIN_REL="${MAIN_ENV#"$PROJECT"/}" ;; *) die "the main environment must be inside $PROJECT (found $MAIN_ENV)" ;; esac
  TMP_DIR="$PROJECT/worktree-tmp"
  WT_DIR="$PROJECT/worktree"
  CONTAINER_REPO="$CONTAINER_ROOT/$MAIN_REL/$REPO_REL"
  LIVE_ROOT="$CONTAINER_ROOT/worktree-tmp"
}

# ---------------------------------------------------------------------------
# Manifest
# ---------------------------------------------------------------------------
arena_dir() { printf '%s/arena/%s' "$PROJECT" "$1"; }

mf_require() {
  SLUG="${1:-}"; [ -n "$SLUG" ] || die "missing <slug> (see ai-arena list)"
  ARENA_DIR="$(arena_dir "$SLUG")"
  MANIFEST="$ARENA_DIR/manifest.json"
  [ -f "$MANIFEST" ] || die "no arena '$SLUG' (expected $MANIFEST). Run: ai-arena init"
  CONTAINER_ARENA="$CONTAINER_ROOT/arena/$SLUG"
}

# Approaches mode: arena/<slug>/approach-<label>.md holds the approach assigned to a
# label (first line = title). The manifest carries .mode and .candidates[].approach (title).
arena_mode() { mf_get '.mode // "models"'; }
arena_plan_by() { mf_get '.plan_by // "pm"'; }
approach_file() { printf '%s/approach-%s.md' "$ARENA_DIR" "$1"; }
approach_title() { # file -> first non-empty line, without heading marks, <= 70 chars
  [ -s "$1" ] || return 0
  grep -m1 -vE '^[[:space:]]*$' "$1" | sed -E 's/^#+[[:space:]]*//' | cut -c1-70
}
sync_approaches() { # copy each approach title into the manifest
  local l t
  for l in $(labels); do
    t="$(approach_title "$(approach_file "$l")")"
    [ -n "$t" ] && cand_set "$l" approach "$t"
  done
}
approaches_summary() { # "a: title; b: title"
  local l t out=""
  for l in $(labels); do t="$(approach_title "$(approach_file "$l")")"; out+="${out:+; }$l: ${t:-?}"; done
  printf '%s' "$out"
}
mf_get() { jq -r "$1" "$MANIFEST"; }
mf_update() {
  local tmp
  (
    flock 9
    tmp="$(mktemp "$MANIFEST.XXXXXX")"; chmod 644 "$tmp"
    jq "$@" "$MANIFEST" > "$tmp" && mv "$tmp" "$MANIFEST"
  ) 9> "$MANIFEST.lock"
}
# "final" is the graft run in the promoted environment: readable like a candidate, but not a label,
# so judge, reveal and clean never touch it.
cand_get() { jq -r --arg l "$1" "(.candidates + [.final // empty])[] | select(.label==\$l) | $2" "$MANIFEST"; }
cand_set() { mf_update --arg l "$1" --arg k "$2" --arg v "$3" '(.candidates[] | select(.label==$l))[$k] = $v | .updated = (now | todate)'; }
cand_set_json() { mf_update --arg l "$1" --arg k "$2" --argjson v "$3" '(.candidates[] | select(.label==$l))[$k] = $v'; }
labels() { jq -r '.candidates[].label' "$MANIFEST"; }
resolve_labels() { if [ $# -eq 0 ]; then labels; else printf '%s\n' "$@"; fi; }
guard_label() { jq -e --arg l "$1" '.candidates[] | select(.label==$l)' "$MANIFEST" >/dev/null || die "unknown candidate label '$1'"; }

slugify() {
  local s
  s="$(printf '%s' "$1" | { iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null || cat; } \
      | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  if [ ${#s} -gt 32 ]; then s="${s:0:32}"; case "$s" in *-*) s="${s%-*}" ;; esac; fi
  printf '%s' "$s" | sed -E 's/-+$//'
}

# ---------------------------------------------------------------------------
# Harness plumbing (all LLM work happens inside the AI containers)
# ---------------------------------------------------------------------------
harness_user() { case "$1" in claude) echo claude ;; opencode) echo opencode ;; *) die "unknown harness '$1' (use claude or opencode)" ;; esac; }
container_for() { case "$1" in claude) echo "ddev-$2-claude-code" ;; opencode) echo "ddev-$2-opencode" ;; *) die "unknown harness '$1'" ;; esac; }
container_running() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$1"; }

harness_cmd() { # harness model session prompt_file_in_container
  local harness="$1" model="$2" session="$3" pfile="$4" cmd
  case "$harness" in
    claude)
      cmd="claude -p --output-format json --permission-mode bypassPermissions"
      [ -n "$model" ] && cmd="$cmd --model $(printf '%q' "$model")"
      [ -n "$session" ] && cmd="$cmd --resume $(printf '%q' "$session")" ;;
    opencode)
      # OpenCode 2: --standalone (private server per run) + --auto (approve
      # permissions not denied by the config; detached runs cannot answer prompts)
      cmd="opencode run --standalone --format json --auto"
      [ -n "$model" ] && cmd="$cmd -m $(printf '%q' "$model")"
      [ -n "$session" ] && cmd="$cmd -s $(printf '%q' "$session")" ;;
  esac
  printf '%s "$(cat %s)"' "$cmd" "$pfile"
}

session_from_output() { # harness file
  case "$1" in
    claude) { jq -r 'if type=="array" then (.[] | select(.session_id?) | .session_id) else (.session_id // empty) end' "$2" 2>/dev/null || true; } | head -n1 || true ;;
    opencode) { grep -o '"sessionID":"[^"]*"' "$2" 2>/dev/null || true; } | head -n1 | cut -d'"' -f4 || true ;;
  esac
}

result_text() { # harness file
  case "$1" in
    claude) jq -r 'if type=="array" then (.[] | select(.result?) | .result) else (.result // empty) end' "$2" 2>/dev/null || cat "$2" ;;
    opencode)
      if jq -e . "$2" >/dev/null 2>&1 || jq -e -s . "$2" >/dev/null 2>&1; then
        jq -r 'select(.type=="text" or .type=="message.part.updated") | (.part.text // .text // empty)' "$2" 2>/dev/null | grep -v '^$' || cat "$2"
      else cat "$2"; fi ;;
  esac
}

# Usage of one harness run as JSON: {steps,input,output,cache_read,cache_write,cost_usd}.
# Claude Code: steps are the main session's turns (subagents have their own, not reported);
# tokens and cost cover the subagents too. OpenCode: one step per model call, reasoning
# counts as output. A field the harness does not report stays null; a free model costs 0.
run_usage() { # harness file
  [ -s "$2" ] || { echo null; return 0; }
  case "$1" in
    claude)
      jq -c 'if type=="array" then (map(select(.total_cost_usd? != null)) | last // {}) else . end
        | ((.modelUsage // {}) | to_entries | map(.value)) as $m
        | def total(k): if ($m | length) > 0 then ($m | map(.[k] // 0) | add) else null end;
          {steps:(.num_turns // null),
           input:(total("inputTokens") // .usage.input_tokens // null),
           output:(total("outputTokens") // .usage.output_tokens // null),
           cache_read:(total("cacheReadInputTokens") // .usage.cache_read_input_tokens // null),
           cache_write:(total("cacheCreationInputTokens") // .usage.cache_creation_input_tokens // null),
           cost_usd:(.total_cost_usd // null)}' "$2" 2>/dev/null || echo null ;;
    opencode)
      { jq -R 'fromjson? // empty' "$2" 2>/dev/null || true; } | jq -c -s '
        map(select(.type == "step_finish") | .part) as $s
        | if ($s | length) == 0 then null else
          {steps:($s | length),
           input:($s | map(.tokens.input // 0) | add),
           output:($s | map((.tokens.output // 0) + (.tokens.reasoning // 0)) | add),
           cache_read:($s | map(.tokens.cache.read // 0) | add),
           cache_write:($s | map(.tokens.cache.write // 0) | add),
           cost_usd:($s | map(.cost // 0) | add)} end' 2>/dev/null || echo null ;;
    *) echo null ;;
  esac
}

parse_verdict() { # text_file -> json
  local f="$1" verdict to winner message
  verdict="$(grep -E '^VERDICT:' "$f" | tail -n1 | sed -E 's/^VERDICT:[[:space:]]*//' || true)"
  to="$(grep -E '^TO:' "$f" | tail -n1 | sed -E 's/^TO:[[:space:]]*//' || true)"
  winner="$(grep -E '^WINNER:' "$f" | tail -n1 | sed -E 's/^WINNER:[[:space:]]*//' || true)"
  message="$(awk 'found{print} /^MESSAGE:/{found=1; sub(/^MESSAGE:[[:space:]]*/, ""); print}' "$f" || true)"
  jq -n --arg verdict "$verdict" --arg to "$to" --arg winner "$winner" --arg message "$message" --rawfile raw "$f" \
    '{verdict:$verdict, to:$to, winner:$winner, message:$message, raw:$raw}'
}

fill_prompt() { # template_name [extra sed args...]
  local t="$1"; shift
  sed -e "s|{{SLUG}}|$SLUG|g" -e "s|{{ARENA}}|$CONTAINER_ARENA|g" -e "s|{{REPO}}|$CONTAINER_REPO|g" -e "s|{{LIVE}}|$LIVE_ROOT|g" "$@" "$PROMPTS_DIR/$t"
}

# Synchronous call to the PM session in the coordinator's AI container.
pm_call() { # message -> prints JSON verdict; stores the session id
  local harness model session container user pfile out logf cmd text
  harness="$(mf_get '.pm.harness')"; model="$(mf_get '.pm.model // empty')"; session="$(mf_get '.pm.session // empty')"
  user="$(harness_user "$harness")"; container="$(container_for "$harness" "$COORD")"
  container_running "$container" || die "container $container is not running (ai-arena up)"
  mkdir -p "$ARENA_DIR/pm"
  pfile="$ARENA_DIR/pm/prompt-$(date +%s).txt"; out="${pfile%.txt}.json"; logf="${pfile%.txt}.log"
  if [ -z "$session" ]; then { fill_prompt pm.md; printf '\n\n%s\n' "$1"; } > "$pfile"; else printf '%s\n' "$1" > "$pfile"; fi
  cmd="$(harness_cmd "$harness" "$model" "$session" "$CONTAINER_ARENA/pm/$(basename "$pfile")")"
  log "pm ($harness${model:+ $model}${session:+, resumed}) ..."
  docker exec -u "$user" -w "$CONTAINER_ROOT" "$container" bash -c "$cmd" < /dev/null > "$out" 2> "$logf" || warn "pm call exited non-zero; see $logf"
  if [ -z "$session" ]; then session="$(session_from_output "$harness" "$out")"; [ -n "$session" ] && mf_update --arg s "$session" '.pm.session = $s'; fi
  text="${pfile%.txt}.md"; result_text "$harness" "$out" > "$text"
  parse_verdict "$text"
}

# ---------------------------------------------------------------------------
# Candidate environments (delegated to worktree-add / worktree-remove)
# ---------------------------------------------------------------------------
agents_env_for() { # harness model -> "K=V;K=V" or empty
  [ -n "$2" ] || return 0
  case "$1" in
    claude)   printf 'CC_MODEL_MAIN=%s;CC_MODEL_NORMAL=%s' "$2" "$2" ;;
    opencode) printf 'OC_MODEL_MAIN=%s;OC_MODEL_NORMAL=%s' "$2" "$2" ;;
  esac
}

create_candidate_env() { # label
  local l="$1" args=()
  args=(--project "$PROJECT" --tmp --name "$(cand_get "$l" '.env_name')" --db "$AI_ARENA_DB" -y)
  [ -n "$AI_ARENA_BASE_REF" ] && args+=(--base-ref "$AI_ARENA_BASE_REF")
  [ -n "$AI_ARENA_LOCAL_FILES" ] && args+=(--local-files "$AI_ARENA_LOCAL_FILES")
  local ae; ae="$(agents_env_for "$(cand_get "$l" '.harness')" "$(cand_get "$l" '.model // empty')")"
  [ -n "$ae" ] && args+=(--agents-env "$ae")
  local ag; ag="$(cand_get "$l" '.agents // empty')"
  if [ -n "$ag" ]; then
    case "$ag" in *://*|*@*:*) ag="${ag//;/,}" ;; *) ag="${AI_ARENA_AGENTS_REPO}#${ag}" ;; esac
    args+=(--agents-sync-env "AGENTS_REPOS=$ag")
  fi
  "$SCRIPT_DIR/worktree-add" "${args[@]}" "$(cand_get "$l" '.branch')" > /dev/null
}

remove_candidate_env() { # label keep_branch(0|1)
  local env_dir branch args=()
  env_dir="$(cand_get "$1" '.env_dir')"; branch="$(cand_get "$1" '.branch')"
  case "$branch" in tmp/*) ;; *) die "refusing to delete branch '$branch': not tmp/*" ;; esac
  case "$env_dir" in "$TMP_DIR/"*) ;; *) die "refusing to remove '$env_dir': not under $TMP_DIR" ;; esac
  args=(--project "$PROJECT" --tmp-only -y -f); [ "$2" = "1" ] && args+=(--keep-branch)
  if [ -d "$env_dir" ]; then
    "$SCRIPT_DIR/worktree-remove" "${args[@]}" "$env_dir"
  elif [ "$2" = "0" ] && git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$REPO_DIR" worktree prune; git -C "$REPO_DIR" branch -D "$branch" >/dev/null && log "deleted branch $branch"
  fi
}

# ---------------------------------------------------------------------------
# Candidate run / wait
# ---------------------------------------------------------------------------
launch_candidate() { # label prompt_text resume(0|1)
  local label="$1" prompt="$2" resume="$3" harness model session env_name env_dir container user cmd
  harness="$(cand_get "$label" '.harness')"; model="$(cand_get "$label" '.model // empty')"; session="$(cand_get "$label" '.session // empty')"
  env_name="$(cand_get "$label" '.env_name')"; env_dir="$(cand_get "$label" '.env_dir')"
  [ -d "$env_dir" ] || die "candidate $label has no environment (ai-arena spawn $SLUG $label)"
  user="$(harness_user "$harness")"; container="$(container_for "$harness" "$env_name")"
  container_running "$container" || die "container $container is not running (cd $env_dir && ddev start)"
  [ "$resume" = "1" ] || session=""
  rm -f "$env_dir/arena-report.md" "$env_dir/arena-run.json" "$env_dir/arena-run.log" "$env_dir/arena-run.exit"
  printf '%s\n' "$prompt" > "$env_dir/arena-prompt.txt"
  cmd="$(harness_cmd "$harness" "$model" "$session" "$CONTAINER_ROOT/arena-prompt.txt")"
  docker exec -d -u "$user" -w "$CONTAINER_ROOT" "$container" \
    bash -c "{ $cmd; } > $CONTAINER_ROOT/arena-run.json 2> $CONTAINER_ROOT/arena-run.log; echo \$? > $CONTAINER_ROOT/arena-run.exit"
  cand_set "$label" state running; cand_set "$label" started "$(now)"; cand_set_json "$label" cut false
  log "candidate $label running in $container ($harness${model:+ $model}${session:+, resumed})"
}

# One entry per run of a candidate (run, then each resume) in .candidates[].rounds, with its
# raw output kept in arena/<slug>/rounds/. duration_s and cost_usd are the sums of the rounds.
# The end time is when the run wrote its exit file, not when a later `wait` noticed it.
record_round() { # label harness exit_code status
  local label="$1" harness="$2" code="$3" status="$4" env_dir started end dur n usage round
  env_dir="$(cand_get "$label" '.env_dir')"; started="$(cand_get "$label" '.started // empty')"
  end="$(stat -c %Y "$env_dir/arena-run.exit" 2>/dev/null || date -u +%s)"
  dur=null; [ -n "$started" ] && dur=$(( end - $(date -u -d "$started" +%s) ))
  n=$(( $(cand_get "$label" '.rounds // [] | length') + 1 ))
  mkdir -p "$ARENA_DIR/rounds"; cp "$env_dir/arena-run.json" "$ARENA_DIR/rounds/$label-$n.json" 2>/dev/null || true
  usage="$(run_usage "$harness" "$env_dir/arena-run.json")"; [ -n "$usage" ] || usage=null
  round="$(jq -cn --argjson n "$n" --arg s "$started" --arg f "$(date -u -d "@$end" +%Y-%m-%dT%H:%M:%SZ)" --argjson d "$dur" --arg c "$code" --arg st "$status" --argjson u "$usage" \
    '{round:$n, started:$s, finished:$f, duration_s:$d, exit_code:$c, status:$st} + (if $u == null then {steps:null, input:null, output:null, cache_read:null, cache_write:null, cost_usd:null} else $u end)')"
  cand_set "$label" finished "$(date -u -d "@$end" +%Y-%m-%dT%H:%M:%SZ)"
  mf_update --arg l "$label" --argjson r "$round" '
    (.candidates[] | select(.label==$l)) |= (.rounds = ((.rounds // []) + [$r])
      | .duration_s = ([.rounds[].duration_s // 0] | add)
      | .cost_usd = ([.rounds[].cost_usd | select(. != null)] as $c | if ($c | length) > 0 then ($c | add) else null end))'
}

# A harness that exits 0 with no report stopped by itself (seen in OpenCode right after an
# automatic compaction: "the user is telling me to stop"). Continue its session instead of
# failing it, up to AI_ARENA_AUTO_CONTINUE times per phase. Stops and deadline cuts exit non-zero.
auto_continue() { # label exit_code session -> 0 if relaunched
  local label="$1" phase n
  [ "$2" = 0 ] && [ -n "$3" ] || return 1
  phase="$(mf_get '.status')"; case "$phase" in drafting|running) ;; *) return 1 ;; esac
  [ "$(cand_get "$label" '.cut // false')" != true ] || return 1
  n="$(cand_get "$label" ".auto_continues.$phase // 0")"
  [ "$n" -lt "${AI_ARENA_AUTO_CONTINUE:-0}" ] || return 1
  [ -d "$(cand_get "$label" '.env_dir')" ] && container_running "$(container_for "$(cand_get "$label" '.harness')" "$(cand_get "$label" '.env_name')")" || return 1
  record_round "$label" "$(cand_get "$label" '.harness')" "$2" STOPPED
  mf_update --arg l "$label" --arg p "$phase" '(.candidates[] | select(.label==$l)).auto_continues[$p] |= ((. // 0) + 1)'
  warn "candidate $label ended without a report: continuing its session ($((n + 1))/$AI_ARENA_AUTO_CONTINUE)"
  launch_candidate "$label" "Nobody asked you to stop: the run ended without a report, probably after an automatic context compaction. Continue the task from where you were, finish it as your instructions say and write $CONTAINER_ROOT/arena-report.md (STATUS first line)." 1
}

settle_candidate() { # label -> prints new state
  local label="$1" env_dir harness exit_code report status="" session
  env_dir="$(cand_get "$label" '.env_dir')"; harness="$(cand_get "$label" '.harness')"
  [ -f "$env_dir/arena-run.exit" ] || { echo running; return 0; }
  exit_code="$(cat "$env_dir/arena-run.exit")"
  session="$(session_from_output "$harness" "$env_dir/arena-run.json")"; [ -n "$session" ] && cand_set "$label" session "$session"
  report="$env_dir/arena-report.md"
  if [ -f "$report" ]; then status="$( { grep -E '^STATUS:' "$report" || true; } | head -n1 | sed -E 's/^STATUS:[[:space:]]*//' | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"; fi
  if [ ! -f "$report" ] && auto_continue "$label" "$exit_code" "$session"; then echo running; return 0; fi
  case "$status" in DONE|BLOCKED|FAILED|PARTIAL) ;; *) status="FAILED" ;; esac
  cand_set "$label" state "$status"; cand_set "$label" exit_code "$exit_code"
  record_round "$label" "$harness" "$exit_code" "$status"
  deadline_note "$label" "$status"
  case "$status" in DONE|PARTIAL)
    if [ "$(mf_get '.status')" = running ] && [ "$(cand_get "$label" '.cut // false')" != true ]; then candidate_reviews_launch "$label"; fi ;;
  esac
  echo "$status"
}

# Phase deadline. The first candidate that finishes a phase (drafting or running) DONE sets
# it: every other one gets AI_ARENA_DEADLINE_FACTOR times that duration, counted from its own
# start, and `wait` stops it after that. Its work so far is still collected and judged.
deadline_note() { # label state
  [ "$2" = DONE ] || return 0
  case "${AI_ARENA_DEADLINE_FACTOR:-0}" in 0|0.0|"") return 0 ;; esac
  local phase dur; phase="$(mf_get '.status')"
  case "$phase" in drafting|running) ;; *) return 0 ;; esac
  [ "$(mf_get '.deadline.phase // empty')" != "$phase" ] || return 0
  dur="$(cand_get "$1" '.rounds[-1].duration_s // empty')"; [ -n "$dur" ] || return 0
  mf_update --arg l "$1" --arg p "$phase" --argjson d "$dur" --argjson f "$AI_ARENA_DEADLINE_FACTOR" \
    '.deadline = {phase:$p, label:$l, first_s:$d, factor:$f, limit_s:(($d * $f) | floor)}'
  log "candidate $1 finished $phase first (${dur}s): the others get $(mf_get '.deadline.limit_s')s each from their start"
}

DEADLINE_STOPPED=""
enforce_deadline() { # stop the candidates of this phase that ran past the deadline
  local limit l started el; DEADLINE_STOPPED=""
  limit="$(jq -r '.status as $p | if .deadline and .deadline.phase == $p then .deadline.limit_s else empty end' "$MANIFEST")"
  [ -n "$limit" ] || return 0
  for l in $(labels); do
    [ "$(cand_get "$l" '.state')" = running ] || continue
    started="$(cand_get "$l" '.started // empty')"; [ -n "$started" ] || continue
    el=$(( $(date -u +%s) - $(date -u -d "$started" +%s) ))
    [ "$el" -ge "$limit" ] || continue
    warn "candidate $l ran ${el}s, past the deadline of ${limit}s ($(mf_get '.deadline.factor')x candidate $(mf_get '.deadline.label')): stopping it; its work so far is still judged"
    cand_set_json "$l" cut true
    stop_candidate "$l"
    DEADLINE_STOPPED+="$l "
  done
}

# Candidate reviews. The candidate already reviewed and fixed its own diff before reporting.
# When it finishes its implementation, two more reviews start at once, inside its own
# environment with its running site: `self`, a fresh session of its own harness and model
# (no memory of writing the code), and `x1`, `x2`..., the other candidates' harnesses. They
# run while the slower candidates still work; `judge` waits for them and reads them beside
# each diff. The labels say self or other, never the model.
xreviewers_for() { # label -> one "harness:model" line per other harness among the candidates
  jq -r --arg h "$(cand_get "$1" '.harness')" '[.candidates[] | select(.harness != $h) | .harness + ":" + (.model // "")] | unique | .[]' "$MANIFEST"
}

review_prompt() { # diff intent tree out runtime -> the reviewer prompt
  sed -e "s|{{DIFF}}|$1|g" -e "s|{{INTENT}}|$2|g" -e "s|{{TREE}}|$3|g" -e "s|{{OUT}}|$4|g" -e "s|{{RUNTIME}}|$5|g" "$PROMPTS_DIR/review.md"
}

candidate_reviews_launch() { # label
  [ "${AI_ARENA_CANDIDATE_REVIEWS:-1}" = 1 ] || return 0
  local label="$1" env_dir env_name dir cdir rl harness model spec n=0 container prompt specs
  env_dir="$(cand_get "$label" '.env_dir')"; env_name="$(cand_get "$label" '.env_name')"
  collect_candidate "$label"
  [ -s "$ARENA_DIR/candidates/$label/diff.patch" ] || { warn "candidate $label changed nothing: no review"; return 0; }
  dir="$env_dir/arena-review"; cdir="$CONTAINER_ROOT/arena-review"
  rm -rf "$dir"; mkdir -p "$dir"; cp "$ARENA_DIR/candidates/$label/diff.patch" "$dir/diff.patch"
  changed_files "$env_dir/$REPO_REL" > "$dir/tree-before.txt"
  printf 'One implementation of an arena task. The binding contract is %s/arena-brief.md: check conformance with it (scope, rubric, required tests) besides correctness. The author report is %s/arena-report.md; its claims are unverified.\n' \
    "$CONTAINER_ROOT" "$CONTAINER_ROOT" > "$dir/intent.txt"
  specs="self $(cand_get "$label" '.harness'):$(cand_get "$label" '.model // empty')"
  if [ "$(arena_mode)" = models ]; then
    while IFS= read -r spec; do [ -n "$spec" ] || continue; n=$((n + 1)); specs+=$'\n'"x$n $spec"; done < <(xreviewers_for "$label")
  fi
  cand_set_json "$label" reviewers '[]'
  while read -r rl spec; do
    harness="${spec%%:*}"; model="${spec#*:}"; container="$(container_for "$harness" "$env_name")"
    container_running "$container" || { warn "cannot review $label with $harness: $container is not running"; continue; }
    prompt="$(review_prompt "$cdir/diff.patch" "$cdir/intent.txt" "$CONTAINER_ROOT/$REPO_REL" "$cdir/$rl.md" "$REVIEW_LIVE")"
    review_launch "$container" "$harness" "$model" "$rl" "$dir" "$cdir" "$prompt"
    mf_update --arg l "$label" --arg r "$rl" --arg h "$harness" --arg m "$model" \
      '(.candidates[] | select(.label==$l)).reviewers += [{label:$r, harness:$h, model:(if $m=="" then null else $m end)}]'
  done <<< "$specs"
}

candidate_reviews_finish() { # wait for the candidate reviews, then put them beside each diff for the judge
  local start l rl dir pending h stray
  start="$(date +%s)"
  while :; do
    pending=0
    for l in $(labels); do for rl in $(cand_get "$l" '.reviewers // [] | .[].label'); do
      [ -f "$(cand_get "$l" '.env_dir')/arena-review/$rl-run.exit" ] || pending=$((pending + 1))
    done; done
    [ "$pending" = 0 ] && break
    if [ "$AI_ARENA_TIMEOUT" -gt 0 ] && [ $(( $(date +%s) - start )) -ge "$AI_ARENA_TIMEOUT" ]; then warn "$pending candidate review(s) still running; judging without them"; break; fi
    [ $(( $(date +%s) - start )) -ge 10 ] || log "waiting for $pending candidate review(s)"
    sleep 10
  done
  for l in $(labels); do
    dir="$(cand_get "$l" '.env_dir')/arena-review"
    for rl in $(cand_get "$l" '.reviewers // [] | .[].label'); do
      [ -f "$dir/$rl-run.exit" ] || continue
      if [ ! -s "$dir/$rl.md" ]; then
        h="$(cand_get "$l" ".reviewers[] | select(.label==\"$rl\") | .harness")"
        result_text "$h" "$dir/$rl-run.json" > "$dir/$rl.md" 2>/dev/null || true
        [ -s "$dir/$rl.md" ] || printf 'NO REVIEW PRODUCED (exit %s)\n' "$(cat "$dir/$rl-run.exit")" > "$dir/$rl.md"
      fi
      mkdir -p "$ARENA_DIR/candidates/$l"; cp "$dir/$rl.md" "$ARENA_DIR/candidates/$l/review-$rl.md"
    done
    if [ -f "$dir/tree-before.txt" ]; then
      # Reviewers read the tree, they must not write in it: anything new would reach the diff.
      stray="$(undeclared_files <(changed_files "$(cand_get "$l" '.env_dir')/$REPO_REL") "$dir/tree-before.txt")"
      [ -z "$stray" ] || warn "a reviewer of $l left files in its tree (remove them, then gate again):"$'\n'"$stray"
    fi
  done
}

status_json() {
  jq '{slug, status, description, mode:(.mode // "models"), coordinator, project, main_env, pm:{harness:.pm.harness, model:.pm.model, session:(.pm.session != null)},
       candidates:[.candidates[] | {label, harness, model, agents, approach, branch, env_name, env_dir, state, exit_code, session:(.session != null), gates, cost_usd, duration_s, rounds}], judge, winner}' "$MANIFEST"
}

status_table() {
  printf '%-6s %-9s %-24s %-14s %-9s %-6s %-8s %-7s %-32s %s\n' LABEL HARNESS MODEL AGENTS STATE GATES COST TIME BRANCH APPROACH
  jq -r '.candidates[] | [.label, .harness, (.model // "(default)"), (.agents // "-"), .state,
          (if .gates then ([.gates | to_entries[] | select(.key != "logs" and .key != "targets") | .value] | map(select(. == "fail")) | length | if . == 0 then "pass" else "fail" end) else "-" end),
          (if .cost_usd then ("$" + (.cost_usd | tostring | .[0:6])) else "-" end), (if .duration_s then ((.duration_s | tostring) + "s") else "-" end),
          .branch, (.approach // "-")] | @tsv' "$MANIFEST" | while IFS=$'\t' read -r l h m a s g c t b ap; do printf '%-6s %-9s %-24s %-14s %-9s %-6s %-8s %-7s %-32s %s\n' "$l" "$h" "$m" "$a" "$s" "$g" "$c" "$t" "$b" "$ap"; done
}

# ---------------------------------------------------------------------------
# Gates and collection
# ---------------------------------------------------------------------------
changed_files() { # wt_repo
  { git -C "$1" diff --name-only HEAD; git -C "$1" ls-files --others --exclude-standard; } 2>/dev/null | sort -u || true
}

report_files() { # report -> the FILES section, one path per line, relative to the repository
  sed -n '/^FILES:/,/^[A-Z][A-Z ]*:/p' "$1" | sed '1d;$d' | sed -E 's/^[-* ]+//; s/[[:space:]]+$//' | { grep -vE '^$|^<|^\(' || true; } | sed -E "s#^$REPO_REL/##"
}

undeclared_files() { # changed_list report_list -> changed paths the report does not list
  { grep -vxFf "$2" "$1" || true; } | { grep -v '^$' || true; }
}

# Hash of a diff without tests, docs and translations: equal hashes mean the candidates
# delivered the same production code, so the arena did not compare what they would build.
production_hash() { # diff.patch -> sha256, empty when nothing is left
  local out
  out="$(awk '/^diff --git /{keep = !($0 ~ /\/tests\/|\.md( |$)|\.po( |$)/)} keep && !/^index /' "$1")"
  if [ -n "$out" ]; then printf '%s' "$out" | sha256sum | cut -d' ' -f1; fi
}

identical_production() { # prints "yes" when every collected candidate has the same production code
  local f h first="" n=0
  shopt -s nullglob
  for f in "$ARENA_DIR"/candidates/*/diff.patch; do
    h="$(production_hash "$f")"
    if [ -z "$h" ] || { [ -n "$first" ] && [ "$h" != "$first" ]; }; then shopt -u nullglob; return 0; fi
    first="$h"; n=$((n + 1))
  done
  shopt -u nullglob
  if [ "$n" -gt 1 ]; then echo yes; fi
}

phpunit_totals() { # gates_dir -> {tests,assertions,failures,errors} summed over the phpunit logs, or null
  local f line t=0 a=0 fa=0 e=0 seen=0 v
  for f in "$1"/phpunit-*.log; do
    [ -f "$f" ] || continue
    line="$(grep -E '^(OK \([0-9]+ tests?, [0-9]+ assertions?\)|Tests: [0-9]+, Assertions: [0-9]+)' "$f" | tail -n1 || true)"
    [ -n "$line" ] || continue
    seen=1
    t=$(( t + $(printf '%s' "$line" | grep -oE '(^OK \(|Tests: )[0-9]+' | grep -oE '[0-9]+') ))
    a=$(( a + $(printf '%s' "$line" | grep -oE '[0-9]+ assertions?|Assertions: [0-9]+' | grep -oE '[0-9]+') ))
    v="$(printf '%s' "$line" | grep -oE 'Failures: [0-9]+' | grep -oE '[0-9]+' || true)"; fa=$(( fa + ${v:-0} ))
    v="$(printf '%s' "$line" | grep -oE 'Errors: [0-9]+' | grep -oE '[0-9]+' || true)"; e=$(( e + ${v:-0} ))
  done
  if [ "$seen" = "1" ]; then printf '{"tests":%s,"assertions":%s,"failures":%s,"errors":%s}' "$t" "$a" "$fa" "$e"; else echo null; fi
}

pending_config() { # env_dir logfile -> number of config items that differ from config/sync, "?" if unknown, empty if nothing came back
  (cd "$1" && ddev drush config:status --format=json 2>"$2") | jq -r 'if type=="array" then length elif type=="object" then (keys | length) else 0 end' 2>/dev/null || echo "?"
}

run_gate() { # env_dir container_dir logfile cmd... -> pass|fail
  local env="$1" cdir="$2" logf="$3"; shift 3
  if (cd "$env" && ddev exec -d "$cdir" "$@") > "$logf" 2>&1; then echo pass; else echo fail; fi
}

gate_candidate() { # label
  local label="$1" env_dir wt_repo cdir gdir site phpstan="skip" phpcs="skip" phpunit="skip" targets docroot t
  env_dir="$(cand_get "$label" '.env_dir')"; wt_repo="$env_dir/$REPO_REL"; cdir="$CONTAINER_ROOT/$REPO_REL"
  gdir="$ARENA_DIR/candidates/$label/gates"; mkdir -p "$gdir"
  log "gates for $label"
  site="fail"; (cd "$env_dir" && ddev drush status --field=bootstrap) 2>"$gdir/site.log" | grep -q Successful && site="pass"
  # Config gate: unexported config changes fail unless the brief allows them.
  local config="skip" pending
  pending="$(pending_config "$env_dir" "$gdir/config.log")"
  if [ "$pending" = "0" ]; then config="pass"
  elif [ "$pending" = "?" ] || [ -z "$pending" ]; then config="skip"
  elif grep -qiE '^[-* ]*config changes:[[:space:]]*allowed' "$ARENA_DIR/brief.md" 2>/dev/null; then config="pass"; printf 'pending config changes: %s (allowed by the brief)\n' "$pending" >> "$gdir/config.log"
  else config="fail"; printf 'pending config changes: %s (not allowed by the brief; export with drush cex or revert)\n' "$pending" >> "$gdir/config.log"; fi
  changed_files "$wt_repo" > "$gdir/changed-files.txt"
  targets="$(sed -nE 's#^(.*/)?((modules|themes|profiles)/custom/[^/]+)/.*#\2#p' "$gdir/changed-files.txt" | sort -u)"
  docroot="$(sed -nE 's#^(.*/)?(modules|themes|profiles)/custom/[^/]+/.*#\1#p' "$gdir/changed-files.txt" | sort -u | head -n1)"
  if [ -n "$targets" ]; then
    local tpaths; tpaths="$(for t in $targets; do printf '%s%s ' "$docroot" "$t"; done)"
    if (cd "$env_dir" && ddev exec -d "$cdir" test -x vendor/bin/phpstan) >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      phpstan="$(run_gate "$env_dir" "$cdir" "$gdir/phpstan.log" vendor/bin/phpstan analyse --no-progress --no-interaction $tpaths)"
    fi
    if (cd "$env_dir" && ddev exec -d "$cdir" test -x vendor/bin/phpcs) >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      phpcs="$(run_gate "$env_dir" "$cdir" "$gdir/phpcs.log" vendor/bin/phpcs --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,test,profile,theme $tpaths)"
    fi
    if (cd "$env_dir" && ddev exec -d "$cdir" test -x vendor/bin/phpunit) >/dev/null 2>&1; then
      local any=0 res
      for t in $targets; do
        [ -d "$wt_repo/$docroot$t/tests" ] || continue; any=1
        if [ -f "$wt_repo/phpunit.xml" ] || [ -f "$wt_repo/phpunit.xml.dist" ]; then
          res="$(run_gate "$env_dir" "$cdir" "$gdir/phpunit-$(basename "$t").log" vendor/bin/phpunit "$docroot$t/tests")"
        else
          res="$(run_gate "$env_dir" "$cdir" "$gdir/phpunit-$(basename "$t").log" env SIMPLETEST_DB=mysql://db:db@db/db SIMPLETEST_BASE_URL=http://localhost vendor/bin/phpunit -c "${docroot}core" "$docroot$t/tests")"
        fi
        [ "$res" = "fail" ] && phpunit="fail"; [ "$res" = "pass" ] && [ "$phpunit" != "fail" ] && phpunit="pass"
      done
      [ "$any" = "1" ] || phpunit="skip"
    fi
  fi
  # Report gate: FILES and the tree must match both ways. A listed path that does not exist
  # means the report contradicts the diff; a changed path that is not listed is a file nobody
  # declared (a scratch database, a stray log), which `git add -A` would carry into the branch.
  local report="skip" rf missing=0 unlisted=0
  if [ -f "$env_dir/arena-report.md" ]; then
    report="pass"; : > "$gdir/report.log"
    report_files "$env_dir/arena-report.md" > "$gdir/report-files.txt"
    while IFS= read -r rf; do
      [ -n "$rf" ] || continue
      grep -qxF "$rf" "$gdir/changed-files.txt" && continue
      [ -e "$wt_repo/$rf" ] || { missing=$((missing+1)); printf 'listed in FILES but absent from the tree: %s\n' "$rf" >> "$gdir/report.log"; }
    done < "$gdir/report-files.txt"
    while IFS= read -r rf; do
      [ -n "$rf" ] || continue
      unlisted=$((unlisted+1)); printf 'changed in the tree but not in FILES: %s\n' "$rf" >> "$gdir/report.log"
    done < <(undeclared_files "$gdir/changed-files.txt" "$gdir/report-files.txt")
    if grep -qiE '^STATUS:[[:space:]]*DONE' "$env_dir/arena-report.md" && ! grep -qE '^SELF-REVIEW([[:space:](:]|$)' "$env_dir/arena-report.md"; then
      missing=$((missing+1)); printf 'STATUS DONE without SELF-REVIEW: review your own diff with code-review, fix what it confirms, then report\n' >> "$gdir/report.log"
    fi
    { [ "$missing" = "0" ] && [ "$unlisted" = "0" ]; } || report="fail"
  fi
  jq -n --arg site "$site" --arg config "$config" --arg phpstan "$phpstan" --arg phpcs "$phpcs" --arg phpunit "$phpunit" --arg report "$report" --arg logs "$gdir" --arg targets "$targets" \
    '{site:$site, config:$config, phpstan:$phpstan, phpcs:$phpcs, phpunit:$phpunit, report:$report, targets:($targets | split("\n") | map(select(. != ""))), logs:$logs}' > "$gdir/../gates.json"
  cand_set_json "$label" gates "$(jq 'del(.logs)' "$gdir/../gates.json")"
  jq -c . "$gdir/../gates.json"
}

tree_diff() { # wt_repo -> tracked diff plus new files, against the branch's last commit
  local f
  git -C "$1" diff HEAD 2>/dev/null || true
  git -C "$1" ls-files --others --exclude-standard 2>/dev/null | while IFS= read -r f; do git -C "$1" diff --no-index -- /dev/null "$f" 2>/dev/null || true; done
}

collect_candidate() { # label
  local label="$1" env_dir wt_repo cdir
  env_dir="$(cand_get "$label" '.env_dir')"; wt_repo="$env_dir/$REPO_REL"; cdir="$ARENA_DIR/candidates/$label"; mkdir -p "$cdir"
  tree_diff "$wt_repo" > "$cdir/diff.patch"
  changed_files "$wt_repo" > "$cdir/files-changed.txt"
  if [ -f "$env_dir/arena-report.md" ]; then cp "$env_dir/arena-report.md" "$cdir/report.md"; else printf 'STATUS: FAILED\n(no report written)\n' > "$cdir/report.md"; fi
  # No harness or model information lands here (not even the harness log): the judge stays blind.
  log "collected $label: $(wc -l < "$cdir/files-changed.txt") file(s) changed"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_doctor() {
  local ok=0 t c v
  [ "$(uname -s)" = "Linux" ] && echo "ok    platform: Linux (bash $BASH_VERSION)" || { echo "warn  platform: $(uname -s) is untested; ai-arena is developed for Linux only"; }
  for t in flock readlink iconv; do command -v "$t" >/dev/null 2>&1 || { echo "MISSING $t (GNU coreutils/util-linux)"; ok=1; }; done
  for t in git jq ddev docker; do command -v "$t" >/dev/null 2>&1 && echo "ok    $t: $(command -v "$t")" || { echo "MISSING $t"; ok=1; }; done
  if [ "$COORD" = "$BASE" ]; then echo "FAIL  coordinator name '$COORD' equals the main environment's name; rename it (ddev config --project-name=${BASE}-arena)"; ok=1; else echo "ok    coordinator: $COORD at $PROJECT"; fi
  echo "ok    main environment: $MAIN_ENV (repo $REPO_REL/, base name $BASE)"
  echo "ok    candidates: $TMP_DIR/${BASE}-tmp-* (branches tmp/*); promoted environments: $WT_DIR/"
  [ -d "$PROMPTS_DIR" ] || { echo "MISSING prompts dir $PROMPTS_DIR"; ok=1; }
  for t in claude opencode; do
    c="$(container_for "$t" "$COORD")"
    if container_running "$c"; then v="$(docker exec -u "$(harness_user "$t")" "$c" "$t" --version 2>/dev/null | head -n1 || echo '?')"; echo "ok    $t container: $c ($v)"
    else echo "warn  $t container not running: $c (ai-arena up)"; fi
  done
  shopt -s nullglob; local snaps=("$MAIN_ENV"/.ddev/db_snapshots/baseline*); shopt -u nullglob
  [ ${#snaps[@]} -gt 0 ] && echo "ok    db snapshot 'baseline' in the main environment" || echo "info  no 'baseline' snapshot: candidates use the newest backups/ dump or an export of main"
  echo "info  free disk: $(df -h "$PROJECT" | awk 'NR==2{print $4}')"
  if [ -n "${AI_ARENA_HOST_SKILL_REPOS:-}" ]; then echo "info  host skill repos: $AI_ARENA_HOST_SKILL_REPOS (host-skills-sync --list)"; fi
  return $ok
}

cmd_up() { log "ddev start ($COORD)"; (cd "$PROJECT" && ddev start -y); }

cmd_init() {
  local task="" candidates="$AI_ARENA_DEFAULT_CANDIDATES" pm="${AI_ARENA_PM_HARNESS}${AI_ARENA_PM_MODEL:+:$AI_ARENA_PM_MODEL}" description="" force=0
  local mode="models" approach_texts=() plan_by=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --candidates) candidates="$2"; shift 2 ;; --pm) pm="$2"; shift 2 ;; --description) description="$2"; shift 2 ;; --force) force=1; shift ;;
      --plan-by) plan_by="${2:-}"; shift 2 ;;
      --approaches) mode="approaches"; shift ;;
      --approach) [ -n "${2:-}" ] || die "--approach needs a text"; approach_texts+=("$2"); mode="approaches"; shift 2 ;;
      -*) die "unknown option $1" ;; *) [ -z "$task" ] && task="$1" || description="$description $1"; shift ;;
    esac
  done
  [ -n "$task" ] || die "usage: init \"<task>\" [--candidates a,b] [--pm harness[:model]] [--description \"...\"] [--approaches | --approach \"...\" ...]"
  [ -n "$description" ] || description="$task"
  # Approaches give each label its design already, so they keep the PM brief unless told otherwise.
  if [ -z "$plan_by" ]; then if [ "$mode" = approaches ]; then plan_by=pm; else plan_by="$AI_ARENA_PLAN_BY"; fi; fi
  case "$plan_by" in pm|candidates) ;; *) die "--plan-by must be pm or candidates" ;; esac
  [ "$plan_by" = pm ] || [ "$mode" = models ] || die "--plan-by candidates does not combine with approaches: there each label already has its design"
  local slug dir; slug="$(slugify "$task")"; [ -n "$slug" ] || die "cannot derive a slug from '$task'"; dir="$(arena_dir "$slug")"
  [ -f "$dir/manifest.json" ] && [ "$force" = "0" ] && die "arena '$slug' exists (use --force to recreate the manifest)"
  mkdir -p "$dir/candidates" "$dir/pm"
  local pm_harness="${pm%%:*}" pm_model=""; [ "$pm" != "$pm_harness" ] && pm_model="${pm#*:}"; harness_user "$pm_harness" >/dev/null
  local specs=() spec i=0 label harness model cands="[]"
  IFS=',' read -r -a specs <<< "$candidates"
  [ ${#specs[@]} -le "$AI_ARENA_MAX_CANDIDATES" ] || die "too many candidates (${#specs[@]} > AI_ARENA_MAX_CANDIDATES=$AI_ARENA_MAX_CANDIDATES)"
  for spec in ${specs[@]+"${specs[@]}"}; do
    spec="$(printf '%s' "$spec" | tr -d '[:space:]')"; [ -n "$spec" ] || continue
    local agents=""; case "$spec" in *@*) agents="${spec#*@}"; spec="${spec%%@*}" ;; esac
    harness="${spec%%:*}"; model=""; [ "$spec" != "$harness" ] && model="${spec#*:}"; harness_user "$harness" >/dev/null
    label="$(printf "\\$(printf '%03o' $((97 + i)))")"
    cands="$(jq --arg l "$label" --arg h "$harness" --arg m "$model" --arg a "$agents" --arg b "tmp/$slug-$label" --arg n "${BASE}-tmp-${slug}-${label}" --arg d "$TMP_DIR/${BASE}-tmp-${slug}-${label}" \
      '. + [{label:$l, harness:$h, model:(if $m=="" then null else $m end), agents:(if $a=="" then null else $a end), branch:$b, env_name:$n, env_dir:$d, state:"init", session:null, gates:null, cost_usd:null, duration_s:null}]' <<< "$cands")"
    i=$((i + 1))
  done
  [ "$i" -gt 0 ] || die "no candidates"
  if [ ${#approach_texts[@]} -gt 0 ]; then
    [ ${#approach_texts[@]} -eq "$i" ] || die "--approach given ${#approach_texts[@]} time(s) for $i candidate(s): one per label, in order (a, b, ...)"
  fi
  rm -f "$dir"/approach-*.md
  jq -n --arg slug "$slug" --arg task "$task" --arg description "$description" --arg created "$(now)" --arg ph "$pm_harness" --arg pm "$pm_model" \
    --arg coord "$COORD" --arg project "$PROJECT" --arg main "$MAIN_ENV" --arg repo "$REPO_REL" --arg mode "$mode" --arg plan_by "$plan_by" --argjson c "$cands" \
    '{slug:$slug, task:$task, description:$description, status:"init", mode:$mode, plan_by:$plan_by, created:$created, coordinator:$coord, project:$project, main_env:$main, repo_rel:$repo,
      pm:{harness:$ph, model:(if $pm=="" then null else $pm end), session:null}, candidates:($c | map(. + {approach:null})), judge:null, winner:null}' > "$dir/manifest.json"
  if [ ${#approach_texts[@]} -gt 0 ]; then
    local k=0 t
    for t in "${approach_texts[@]}"; do
      label="$(printf "\\$(printf '%03o' $((97 + k)))")"
      printf '%s\n' "$t" > "$dir/approach-$label.md"
      k=$((k + 1))
    done
    ARENA_DIR="$dir"; MANIFEST="$dir/manifest.json"; sync_approaches
    log "approaches assigned: $(approaches_summary)"
  elif [ "$mode" = approaches ]; then
    log "approaches mode: the PM proposes one approach per label in 'plan' (confirm them before spawn)"
  fi
  log "arena '$slug' created with $i candidate(s), mode $mode: $dir"
  echo "$slug"
}

brief_lint() { # brief.md -> the lines candidates would trip on: lost ssh quoting, git in the container, literal test gates
  grep -nE "ssh web drush (php:eval|ev|sqlq|sql:query) ['\"]|ssh web (ba)?sh -l?c|git (status|diff)|OK \([0-9]+ test" "$1" || true
}

check_brief() { # warn about commands the candidates would trip on
  local hits; hits="$(brief_lint "$ARENA_DIR/brief.md")"
  [ -z "$hits" ] || warn "brief.md carries commands that fail or mislead in the candidates' containers; have the PM rewrite them with 'ai-arena pm' before running them:"$'\n'"$hits"
}

cmd_plan() {
  mf_require "${1:-}"; shift || true
  [ "$(arena_plan_by)" = pm ] || die "this arena plans in the candidates: ai-arena spawn, draft, wait --all, merge"
  local description="${1:-$(mf_get '.description')}" msg block="" l
  msg="$(fill_prompt plan.md)"; msg="${msg//\{\{TASK\}\}/$description}"; msg="${msg//\{\{CANDIDATES\}\}/$(labels | tr '\n' ' ')}"
  if [ "$(arena_mode)" = approaches ]; then
    if ls "$ARENA_DIR"/approach-*.md >/dev/null 2>&1; then
      block="APPROACHES MODE, user-defined. Every candidate works from the same Implementation Contract, but each label has an ASSIGNED approach the user already wrote:"$'\n'
      for l in $(labels); do block+="- $l: $(approach_title "$(approach_file "$l")") (full text: $CONTAINER_ARENA/approach-$l.md)"$'\n'; done
      block+="Read them. Keep the Implementation Contract approach-neutral: everything that differs between approaches lives in those files, not in the contract (the rubric and the live verification must be satisfiable by every approach). Do not rewrite the approach files; if one cannot work in this codebase, reply with VERDICT: ASK_USER and say why."
    else
      block="APPROACHES MODE, PM-proposed. The candidates ($(labels | tr '\n' ' ')) run the same model; the variable under test is the approach. From the codebase, propose one genuinely different and defensible approach per label (different placement, mechanism or trade-off, not cosmetic variants) and write each to $CONTAINER_ARENA/approach-<label>.md: first line a short title, then what to build differently, where, and what to avoid. Keep the Implementation Contract approach-neutral (rubric and live verification satisfiable by every approach). Then reply with VERDICT: ASK_USER listing the approaches, one line per label, so the user confirms or changes them before anything is spawned."
    fi
  fi
  msg="${msg//\{\{APPROACHES\}\}/$block}"
  pm_call "$msg"
  if [ ! -s "$ARENA_DIR/brief.md" ]; then
    # The usual cause: the PM delegated the plan to a background subagent that the harness
    # killed. One retry, explicitly in the foreground, before giving up.
    warn "the PM did not write brief.md; asking it once more to write it in the foreground"
    pm_call "brief.md was not written (a background subagent was probably killed by the harness). Do NOT spawn background subagents. Write $CONTAINER_ARENA/brief.md yourself now, in this turn, from what you already read plus the task description in manifest.json, following the BRIEF FORMAT of the arena-protocol skill. Then reply with VERDICT: DONE."
    [ -s "$ARENA_DIR/brief.md" ] || die "the PM did not write $ARENA_DIR/brief.md (see arena/$SLUG/pm/*.log)"
  fi
  if [ "$(arena_mode)" = approaches ]; then
    for l in $(labels); do [ -s "$(approach_file "$l")" ] || warn "no approach for label $l yet ($(approach_file "$l")); settle it with 'ai-arena pm' before run"; done
    sync_approaches
  fi
  check_brief
  mf_update '.status = "planned"'; log "brief written: $ARENA_DIR/brief.md"
}

cmd_draft() { # phase 1: every candidate investigates and writes its own plan
  mf_require "${1:-}"; shift || true
  [ "$(arena_plan_by)" = candidates ] || die "this arena is planned by the PM: ai-arena plan $SLUG"
  local l env_dir prompt; prompt="$(sed -e "s|{{REPO}}|$CONTAINER_ROOT/$REPO_REL|g" -e "s|{{SLUG}}|$SLUG|g" "$PROMPTS_DIR/planner.md")"
  for l in $(resolve_labels "$@"); do
    guard_label "$l"
    case "$(cand_get "$l" '.state')" in ready|BLOCKED|FAILED|PARTIAL) ;; running) warn "$l already running"; continue ;; *) warn "$l not ready"; continue ;; esac
    env_dir="$(cand_get "$l" '.env_dir')"; rm -f "$env_dir/arena-plan.md"
    printf '# Arena task: %s\n\n## Task\n%s\n\n%s\n' "$SLUG" "$(mf_get '.task')" "$(mf_get '.description')" > "$env_dir/arena-brief.md"
    launch_candidate "$l" "$prompt" 0
  done
  mf_update '.status = "drafting" | .deadline = null'
}

collect_plans() { # copy each finished plan under blind labels; prints the labels that have one
  local l env_dir got="" n; mkdir -p "$ARENA_DIR/plans"
  for l in $(labels); do
    env_dir="$(cand_get "$l" '.env_dir')"
    if [ -s "$env_dir/arena-plan.md" ]; then cp "$env_dir/arena-plan.md" "$ARENA_DIR/plans/$l.md"; got+="$l "
    else warn "candidate $l wrote no plan"; fi
    [ -z "$(changed_files "$env_dir/$REPO_REL")" ] || warn "candidate $l changed files while planning; review its tree before it implements"
    # A planner must not write to its database either: what it leaves there breaks the config gate later.
    n="$(pending_config "$env_dir" /dev/null)"
    case "$n" in ""|0|"?") ;; *) warn "candidate $l left $n config change(s) in its database while planning: check 'ddev drush config:status' in $env_dir and revert them before it implements" ;; esac
  done
  printf '%s' "$got"
}

cmd_merge() { # phase 1 ends: the PM turns the plans into the one brief everybody implements
  mf_require "${1:-}"; shift || true
  [ "$(arena_plan_by)" = candidates ] || die "this arena is planned by the PM: ai-arena plan $SLUG"
  local got msg out l
  for l in $(labels); do [ "$(cand_get "$l" '.state')" != running ] || die "candidate $l is still running (ai-arena wait $SLUG --all)"; done
  got="$(collect_plans)"; [ -n "$got" ] || die "no plan to merge (ai-arena draft $SLUG)"
  msg="$(fill_prompt merge.md)"; msg="${msg//\{\{TASK\}\}/$(mf_get '.description')}"; msg="${msg//\{\{PLANS\}\}/$CONTAINER_ARENA/plans/ ($got)}"
  local cut; cut="$(jq -r '[.candidates[] | select(.cut == true) | .label] | join(" ")' "$MANIFEST")"
  [ -z "$cut" ] || msg+=$'\n\n'"STOPPED AT THE DEADLINE: $cut ran past the time limit and their plans are unfinished. They cannot be the base plan; take from them only what is sound and checked against the code."
  out="$(pm_call "$msg")"; mf_update --argjson j "$out" '.plan_verdict = $j'
  if [ -s "$ARENA_DIR/brief.md" ]; then check_brief; mf_update '.status = "planned"'; log "brief written: $ARENA_DIR/brief.md"
  else warn "the PM wrote no brief yet; answer it with 'ai-arena pm' and ask it to write brief.md"; fi
  printf '%s\n' "$out"
}

cmd_spawn() {
  mf_require "${1:-}"; shift || true
  local l
  for l in $(resolve_labels "$@"); do
    guard_label "$l"
    case "$(cand_get "$l" '.state')" in init|spawn-failed) ;; *) warn "candidate $l is not in state init; skipping"; continue ;; esac
    if create_candidate_env "$l"; then cand_set "$l" state ready; log "candidate $l ready: $(cand_get "$l" '.env_dir')"
    else cand_set "$l" state spawn-failed; warn "spawn failed for $l (fix the cause, then: ai-arena spawn $SLUG $l)"; fi
  done
  mf_update '.status = "spawned"'
}

cmd_run() {
  mf_require "${1:-}"; shift || true
  [ -s "$ARENA_DIR/brief.md" ] || die "no brief (ai-arena $([ "$(arena_plan_by)" = pm ] && echo plan || echo merge) $SLUG)"
  # Inside a candidate's own container the repo sits at /var/www/html/<repo>, not at the coordinator path.
  local l prompt env_dir note p resume; prompt="$(sed -e "s|{{REPO}}|$CONTAINER_ROOT/$REPO_REL|g" -e "s|{{SLUG}}|$SLUG|g" "$PROMPTS_DIR/candidate.md")"
  if [ "$(arena_mode)" = approaches ]; then
    for l in $(resolve_labels "$@"); do [ -s "$(approach_file "$l")" ] || die "approaches mode but no approach for label $l ($(approach_file "$l")): run 'ai-arena plan' / 'ai-arena pm' first"; done
    sync_approaches
  fi
  for l in $(resolve_labels "$@"); do
    guard_label "$l"
    case "$(cand_get "$l" '.state')" in ready|DONE|BLOCKED|FAILED|PARTIAL) ;; running) warn "$l already running"; continue ;; *) warn "$l not ready"; continue ;; esac
    env_dir="$(cand_get "$l" '.env_dir')"; cp "$ARENA_DIR/brief.md" "$env_dir/arena-brief.md"
    note=""
    if [ -s "$(approach_file "$l")" ]; then
      cp "$(approach_file "$l")" "$env_dir/arena-approach.md"
      note="Your ASSIGNED APPROACH is in /var/www/html/arena-approach.md. It is binding like the contract: follow it even where you would choose differently, and name it in SUMMARY. If it cannot work in this codebase, report STATUS: BLOCKED explaining why instead of switching approach silently."
    else
      rm -f "$env_dir/arena-approach.md"
    fi
    # A planner keeps its session: it already knows the code, and implementing needs no second
    # investigation. A harness in AI_ARENA_RUN_FRESH starts clean and reads its own plan instead,
    # so it does not begin the implementation with a context already near compaction.
    resume=0
    if [ "$(arena_plan_by)" = candidates ]; then
      if [[ " ${AI_ARENA_RUN_FRESH//,/ } " == *" $(cand_get "$l" '.harness') "* ]]; then
        note="The project manager merged all the plans into /var/www/html/arena-brief.md: it is the task."
        [ ! -s "$env_dir/arena-plan.md" ] || note+=" In the planning phase you wrote /var/www/html/arena-plan.md: reuse the facts it verified instead of investigating them again; where it differs from the brief, the brief binds."
      elif [ -n "$(cand_get "$l" '.session // empty')" ]; then
        resume=1; note="The project manager merged all the plans into /var/www/html/arena-brief.md. It replaces your plan: where they differ, the brief binds, whoever wrote the idea."
      fi
    fi
    p="${prompt//\{\{APPROACH_NOTE\}\}/$note}"
    launch_candidate "$l" "$p" "$resume"
  done
  mf_update '.status = "running" | .deadline = null'
}

cmd_resume() {
  mf_require "${1:-}"; shift || true
  local l="${1:-}" msg="${2:-}"; [ -n "$l" ] && guard_label "$l"; [ -n "$l" ] && [ -n "$msg" ] || die "usage: resume <slug> <label> \"<message>\""
  [ "$(cand_get "$l" '.state')" != "running" ] || die "candidate $l is still running (ai-arena wait $SLUG)"
  [ -n "$(cand_get "$l" '.session // empty')" ] || die "candidate $l has no session to resume"
  launch_candidate "$l" "$msg"$'\n\n'"When done, rewrite $CONTAINER_ROOT/arena-report.md (STATUS first line) as before." 1
}

cmd_stop() { # kill a running candidate's harness; settle its state from the report written so far
  mf_require "${1:-}"; shift || true
  [ $# -gt 0 ] || die "usage: stop <slug> <label...>"
  local l
  for l in "$@"; do
    guard_label "$l"
    [ "$(cand_get "$l" '.state')" = "running" ] || { warn "candidate $l is not running"; continue; }
    stop_candidate "$l"
  done
  status_json
}

stop_candidate() { # label -> kill its harness, then settle its state from the report written so far
  local l="$1" harness env_name env_dir container user st
  harness="$(cand_get "$l" '.harness')"; env_name="$(cand_get "$l" '.env_name')"; env_dir="$(cand_get "$l" '.env_dir')"
  user="$(harness_user "$harness")"; container="$(container_for "$harness" "$env_name")"
  if container_running "$container"; then
    # Everything the harness user runs in that container belongs to this run (the wrapper,
    # the harness, its subagents and tool processes). TERM first, KILL what survives.
    docker exec -u root "$container" pkill -TERM -u "$user" >/dev/null 2>&1 || true
    sleep 5
    docker exec -u root "$container" pkill -KILL -u "$user" >/dev/null 2>&1 || true
  else
    warn "container $container is not running"
  fi
  # The wrapper writes arena-run.exit itself when it survives the kill; otherwise record it.
  sleep 2
  [ -f "$env_dir/arena-run.exit" ] || echo 143 > "$env_dir/arena-run.exit"
  st="$(settle_candidate "$l")"
  log "candidate $l stopped -> $st (exit $(cat "$env_dir/arena-run.exit"))"
}

cmd_wait() {
  mf_require "${1:-}"; shift || true
  local all=0 timeout="$AI_ARENA_WAIT_TIMEOUT" interval=15 start l st changed
  while [ $# -gt 0 ]; do case "$1" in --all) all=1; shift ;; --timeout) timeout="$2"; shift 2 ;; --interval) interval="$2"; shift 2 ;; *) die "unknown option $1" ;; esac; done
  start="$(date +%s)"
  while :; do
    changed=0
    for l in $(labels); do
      [ "$(cand_get "$l" '.state')" = "running" ] || continue
      st="$(settle_candidate "$l")"; [ "$st" = "running" ] || { changed=1; log "candidate $l -> $st"; }
    done
    enforce_deadline; [ -z "$DEADLINE_STOPPED" ] || changed=1
    [ "$changed" = "1" ] && [ "$all" = "0" ] && break
    jq -e '.candidates[] | select(.state=="running")' "$MANIFEST" >/dev/null || break
    if [ "$timeout" -gt 0 ] && [ $(( $(date +%s) - start )) -ge "$timeout" ]; then status_json; die "timeout after ${timeout}s with candidates still running"; fi
    sleep "$interval"
  done
  status_json
}

cmd_status() {
  mf_require "${1:-}"; shift || true
  local l; for l in $(labels); do [ "$(cand_get "$l" '.state')" = "running" ] && settle_candidate "$l" >/dev/null; done
  if [ "${1:-}" = "--json" ]; then status_json; else
    echo "arena: $SLUG ($(mf_get '.status'))  task: $(mf_get '.task')"; status_table
    [ -z "$(mf_get '.winner.env_dir // empty')" ] || echo "final code: $(final_review_state)"
  fi
}

final_review_state() { # whether the last `review --arena` read the code as it is now
  local env last; env="$(mf_get '.winner.env_dir // empty')"; last="$(mf_get '.reviews // [] | last | .diff_sha // empty')"
  if [ -z "$last" ]; then echo "not reviewed (ai-arena review --arena $SLUG)"
  elif [ "$(tree_diff "$env/$REPO_REL" | sha256sum | cut -d' ' -f1)" = "$last" ]; then echo "reviewed as it is ($(mf_get '.reviews | last | .dir'))"
  else echo "changed since the last review (ai-arena review --arena $SLUG)"; fi
}

cmd_pm() { mf_require "${1:-}"; shift || true; [ -n "${1:-}" ] || die "usage: pm <slug> \"<message>\""; pm_call "$1"; }

cmd_gate() { mf_require "${1:-}"; shift || true; local l; for l in $(resolve_labels "$@"); do guard_label "$l"; [ -d "$(cand_get "$l" '.env_dir')" ] || { warn "$l has no environment"; continue; }; gate_candidate "$l"; done; }

cmd_collect() {
  mf_require "${1:-}"; shift || true
  local l; for l in $(labels); do [ -d "$(cand_get "$l" '.env_dir')" ] || continue; collect_candidate "$l"; done
  mf_update '.status = "collected"'
  if [ "$(identical_production)" = "yes" ]; then
    warn "every candidate delivered the same production code: the brief probably dictated it, so this arena did not compare implementations"
  fi
}

compare_json() {
  local l tests rows="[]"
  for l in $(labels); do
    tests="$(phpunit_totals "$ARENA_DIR/candidates/$l/gates")"
    rows="$(jq -c --argjson r "$rows" --arg l "$l" --argjson t "$tests" '
      [.candidates[] | select(.label==$l)] | first as $c
      | ($c.rounds // []) as $rounds
      | def tok(x): ($rounds | map(x // 0) | add // 0);
      $r + [{label:$l, state:$c.state, rounds:$rounds, duration_s:$c.duration_s, cost_usd:$c.cost_usd,
             steps:tok(.steps), tokens:(tok(.input) + tok(.output) + tok(.cache_read) + tok(.cache_write)),
             tests:$t, gates:(if $c.gates then ($c.gates | del(.targets)) else null end)}]' "$MANIFEST")"
  done
  jq -n --arg slug "$SLUG" --arg same "$(identical_production)" --argjson c "$rows" '{slug:$slug, identical_production_code:($same == "yes"), candidates:$c}'
}

cmd_compare() {
  mf_require "${1:-}"; shift || true
  local data; data="$(compare_json)"
  if [ "${1:-}" = "--json" ]; then printf '%s\n' "$data"; return 0; fi
  echo "arena: $SLUG"
  if [ "$(jq -r .identical_production_code <<< "$data")" = "true" ]; then echo "note: every candidate delivered the same production code"; fi
  printf '%-6s %-6s %-11s %-6s %-14s %-9s\n' LABEL ROUND TIME STEPS TOKENS COST
  jq -r 'def hm: if . == null then "-" else "\(. / 3600 | floor) h \(((. % 3600) / 60 + 0.5) | floor) min" end;
    def money: if . == null then "-" else "$" + ((. * 100 | round) / 100 | tostring) end;
    def sum4: [.input, .output, .cache_read, .cache_write] | if all(. == null) then null else map(. // 0) | add end;
    .candidates[] | . as $c
    | ((.rounds[]? | [$c.label, (.round | tostring), (.duration_s | hm), (.steps // "-" | tostring), (sum4 // "-" | tostring), (.cost_usd | money)]),
       [$c.label, "total", ($c.duration_s | hm), ($c.steps | tostring), ($c.tokens | tostring), ($c.cost_usd | money)]) | @tsv' <<< "$data" \
    | while IFS=$'\t' read -r l r t st to c; do printf '%-6s %-6s %-11s %-6s %-14s %-9s\n' "$l" "$r" "$t" "$st" "$to" "$c"; done
  jq -r '.candidates[] | "\(.label): " + (if .tests then "\(.tests.tests) tests, \(.tests.failures) failures, \(.tests.errors) errors" else "no test run" end)
    + "; gates: " + (if .gates then ([.gates | to_entries[] | select(.key != "logs" and .value == "fail") | .key] | if length == 0 then "all pass" else "failed " + join(", ") end) else "not run" end)' <<< "$data"
  echo "steps: main session turns for Claude Code (subagents excluded), model calls for OpenCode."
}

cmd_judge() {
  mf_require "${1:-}"; shift || true
  ls "$ARENA_DIR"/candidates/*/report.md >/dev/null 2>&1 || die "nothing collected (ai-arena collect $SLUG)"
  local msg out block=""; msg="$(fill_prompt judge.md)"; msg="${msg//\{\{CANDIDATES\}\}/$(labels | tr '\n' ' ')}"
  if [ "$(arena_mode)" = approaches ]; then
    block="APPROACHES MODE: each label was ASSIGNED its approach ($(approaches_summary); full texts in $CONTAINER_ARENA/approach-<label>.md). The candidates did not choose them, so judge the approaches as implemented: contract conformance, size and reader load of the change, test footprint, config churn, risk and maintainability. The winner is the approach to adopt. Do not penalise a label for following its assigned approach; do penalise one that abandoned it silently. Say explicitly which approach wins and why the other loses."
  fi
  if [ "$(identical_production)" = "yes" ]; then
    block+="${block:+ }MECHANICAL NOTE: the production code of every candidate is identical (only tests, docs or translations differ). Say so first in your verdict: the ranking can only reflect tests, evidence and reporting, not which implementation is better."
  fi
  candidate_reviews_finish
  if ls "$ARENA_DIR"/candidates/*/review-*.md >/dev/null 2>&1; then
    block+="${block:+ }REVIEWS: each candidate reviewed and fixed its own diff before reporting (SELF-REVIEW in report.md). Then candidates/L/review-self.md was written by a fresh session of the same model as L's author, and review-x1.md (x2...) by different models, all with L's site running. A finding raised by both self and another is the strongest signal; one only another model raised is the author's blind spot. Treat every finding as a lead: confirm it in the diff, the code or the pasted output, or refute it in one line. Confirmed ones weigh in the ranking and must be named in your verdict so they get fixed."
  fi
  local cut; cut="$(jq -r '[.candidates[] | select(.cut == true) | .label] | join(" ")' "$MANIFEST")"
  if [ -n "$cut" ]; then
    block+="${block:+ }STOPPED AT THE DEADLINE: $cut ran past $(mf_get '.deadline.factor // 2')x the time of the first candidate to finish and were stopped unfinished. They cannot win. Read their diffs anyway: anything they did better than the winner, even half done, is a graft."
  fi
  if [ "$(arena_plan_by)" = candidates ]; then
    block+="${block:+ }GRAFTS: besides the winner, write $CONTAINER_ARENA/grafts.md, the list a fresh agent will port into the winner: one item per concrete improvement, naming the source label, its file, what to port and why it beats the winner's version, plus one item per confirmed review finding on the winner, as a fix. Only what is clearly better or confirmed; write the single word none if nothing is."
  fi
  msg="${msg//\{\{APPROACHES\}\}/$block}"
  out="$(pm_call "$msg")"; mf_update --argjson j "$out" '.judge = $j | .status = "judged"'; printf '%s\n' "$out"
}

grafts_empty() { # grafts.md -> success when it lists nothing to port
  ! grep -qviE '^[[:space:]]*(none\.?)?[[:space:]]*$' "$1"
}

cmd_graft() { # last phase: the best parts of the losers, in the real environment of the winner
  mf_require "${1:-}"; shift || true
  local message=""
  while [ $# -gt 0 ]; do case "$1" in --message) message="${2:?}"; shift 2 ;; *) die "unknown option $1" ;; esac; done
  local winner env grafts; winner="$(mf_get '.winner.label // empty')"; env="$(mf_get '.winner.env_dir // empty')"; grafts="$ARENA_DIR/grafts.md"
  { [ -n "$winner" ] && [ -n "$env" ] && [ -d "$env" ]; } || die "no promoted environment (ai-arena promote $SLUG <winner> --env)"
  [ -f "$grafts" ] || die "no $grafts (the judge writes it in --plan-by candidates arenas; 'ai-arena pm' can ask for it)"
  if [ -z "$message" ] && grafts_empty "$grafts"; then log "the judge listed nothing to graft; next: ai-arena review --arena $SLUG"; return 0; fi
  local harness model session="" name container user l pfile cmd status
  harness="$(cand_get "$winner" '.harness')"; model="$(cand_get "$winner" '.model // empty')"; name="$(ddev_name "$env")"
  user="$(harness_user "$harness")"; container="$(container_for "$harness" "$name")"
  container_running "$container" || die "container $container is not running (cd $env && ddev start)"
  mkdir -p "$env/arena-grafts"; cp "$grafts" "$env/arena-grafts/grafts.md"; cp "$ARENA_DIR/brief.md" "$env/arena-brief.md"
  for l in $(labels); do
    [ "$l" = "$winner" ] || [ ! -f "$ARENA_DIR/candidates/$l/diff.patch" ] || cp "$ARENA_DIR/candidates/$l/diff.patch" "$env/arena-grafts/$l.patch"
  done
  pfile="$env/arena-graft-prompt.txt"; rm -f "$env/arena-report.md"
  if [ -n "$message" ]; then
    session="$(mf_get '.final.session // empty')"; printf '%s\n\nWhen done, rewrite %s/arena-report.md (STATUS first line) as before.\n' "$message" "$CONTAINER_ROOT" > "$pfile"
  else
    sed -e "s|{{REPO}}|$CONTAINER_ROOT/$REPO_REL|g" -e "s|{{SLUG}}|$SLUG|g" "$PROMPTS_DIR/graft.md" > "$pfile"
  fi
  cmd="$(harness_cmd "$harness" "$model" "$session" "$CONTAINER_ROOT/arena-graft-prompt.txt")"
  log "graft ($harness${model:+ $model}${session:+, resumed}) in $env ..."
  docker exec -u "$user" -w "$CONTAINER_ROOT" "$container" bash -c "$cmd" < /dev/null > "$env/arena-run.json" 2> "$env/arena-run.log" || warn "graft run exited non-zero; see $env/arena-run.log"
  session="$(session_from_output "$harness" "$env/arena-run.json")"
  status="$( { grep -E '^STATUS:' "$env/arena-report.md" 2>/dev/null || true; } | head -n1 | sed -E 's/^STATUS:[[:space:]]*//' | tr -d '[:space:]')"
  mf_update --arg h "$harness" --arg m "$model" --arg s "$session" --arg n "$name" --arg d "$env" --arg st "${status:-FAILED}" \
    '.final = {label:"final", harness:$h, model:(if $m=="" then null else $m end), session:(if $s=="" then .final.session else $s end), env_name:$n, env_dir:$d, state:$st} | .status = "grafted"'
  log "graft finished: ${status:-FAILED}. Nothing is committed: the changes wait in $env/$REPO_REL"
  gate_candidate final
  log "next: ai-arena review --arena $SLUG (the harnesses that did not write this code review it)"
}

cmd_promote() {
  mf_require "${1:-}"; shift || true
  local l="${1:-}"; [ -n "$l" ] || die "usage: promote <slug> <label> [--branch name] [--env] [--allow-undeclared]"; shift; guard_label "$l"
  local target="feature/$SLUG" env=0 allow=0
  while [ $# -gt 0 ]; do case "$1" in --branch) target="${2:?}"; shift 2 ;; --env) env=1; shift ;; --allow-undeclared) allow=1; shift ;; *) die "unknown option $1" ;; esac; done
  local src wt; src="$(cand_get "$l" '.branch')"; wt="$(cand_get "$l" '.env_dir')/$REPO_REL"
  git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$src" || die "branch $src does not exist"
  git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$target" && die "branch $target already exists"
  # Candidates never commit: record their working tree on the tmp branch so the
  # promoted branch carries the work (this is the only commit the tool ever makes).
  if [ -d "$wt" ] && [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
    # `add -A` takes everything in the tree, so nothing the winner did not declare may be there.
    if [ "$allow" = "0" ]; then
      local changed declared extra report; report="$(cand_get "$l" '.env_dir')/arena-report.md"
      changed="$(mktemp)"; declared="$(mktemp)"
      changed_files "$wt" > "$changed"; if [ -f "$report" ]; then report_files "$report" > "$declared"; fi
      extra="$(undeclared_files "$changed" "$declared")"; rm -f "$changed" "$declared"
      [ -z "$extra" ] || die "files in $wt that the report does not declare (remove them, or repeat with --allow-undeclared):"$'\n'"$extra"
    fi
    git -C "$wt" add -A
    git -C "$wt" -c user.name="ai-arena" -c user.email="ai-arena@localhost" commit -q -m "arena $SLUG: candidate $l (work in progress, review before merging)"
    log "recorded candidate $l's working tree on $src"
  fi
  git -C "$REPO_DIR" branch "$target" "$src"
  mf_update --arg w "$l" --arg t "$target" '.winner = {label:$w, branch:$t} | .status = "promoted"'
  log "created $target from $src (candidate $l)"
  if [ "$env" = "1" ]; then
    local d; d="$("$SCRIPT_DIR/worktree-add" --project "$PROJECT" --db "$AI_ARENA_DB" -y "$target" | tail -n1)"
    mf_update --arg d "$d" '.winner.env_dir = $d'; log "environment ready: $d"
  fi
}

cmd_reveal() {
  mf_require "${1:-}"; shift || true
  local winner; winner="$(mf_get '.winner.label // .judge.winner // empty')"
  case "$winner" in ""|none|NONE|None) winner="" ;; esac
  if [ -n "$winner" ] && ! jq -e --arg l "$winner" '.candidates[] | select(.label==$l)' "$MANIFEST" >/dev/null; then warn "judge named '$winner', which is not a label"; winner=""; fi
  echo "arena: $SLUG   mode: $(arena_mode)   winner: ${winner:-(none yet)}"
  [ "$(arena_plan_by)" = pm ] || echo "base plan: $(mf_get '.plan_verdict.winner // "(none yet)"')"
  printf '%-6s %-9s %-24s %-24s %-8s %-7s %s\n' LABEL HARNESS MODEL AGENTS COST TIME APPROACH
  jq -r '.candidates[] | [.label, .harness, (.model // "(default)"), (.agents // "-"), (.cost_usd // "-" | tostring), (.duration_s // "-" | tostring), (.approach // "-")] | @tsv' "$MANIFEST" | while IFS=$'\t' read -r l h m a c t ap; do printf '%-6s %-9s %-24s %-24s %-8s %-7s %s\n' "$l" "$h" "$m" "$a" "$c" "$t" "$ap"; done
  if [ -n "$winner" ]; then
    mkdir -p "$(dirname "$WINS_LOG")"; [ -f "$WINS_LOG" ] || printf 'ts\tproject\tslug\twinner\tharness\tmodel\tagents\tcost_usd\tduration_s\tcandidates\n' > "$WINS_LOG"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(now)" "$COORD" "$SLUG" "$winner" "$(cand_get "$winner" '.harness')" "$(cand_get "$winner" '.model // "(default)"')" \
      "$(cand_get "$winner" '.agents // "-"')" "$(cand_get "$winner" '.cost_usd // "-"')" "$(cand_get "$winner" '.duration_s // "-"')" \
      "$(jq -r '[.candidates[] | .harness + ":" + (.model // "default") + (if .agents then "@" + .agents else "" end) + (if .approach then "#" + .approach else "" end) + "=" + (.cost_usd // "-" | tostring) + "$/" + (.duration_s // "-" | tostring) + "s"] | join(",")' "$MANIFEST")" >> "$WINS_LOG"
    log "logged to $WINS_LOG"
  fi
}

cmd_clean() {
  mf_require "${1:-}"; shift || true
  local keep="" purge=0 l winner keep_branch
  while [ $# -gt 0 ]; do case "$1" in --keep) keep="$2"; shift 2 ;; --purge) purge=1; shift ;; *) die "unknown option $1" ;; esac; done
  winner="$(mf_get '.winner.label // empty')"
  local judged; judged="$(mf_get '.judge.winner // empty')"; case "$judged" in none|NONE|None) judged="" ;; esac
  if [ -z "$winner" ] && [ -n "$judged" ] && [ -z "$keep" ]; then
    die "the judge picked '$judged' but nothing was promoted; run: ai-arena promote $SLUG $judged (or clean --keep $judged)"
  fi
  for l in $(labels); do
    keep_branch=0; { [ "$l" = "$keep" ] || [ "$l" = "$winner" ]; } && keep_branch=1
    [ "$(cand_get "$l" '.state')" = "running" ] && { warn "candidate $l is still running; skipping"; continue; }
    remove_candidate_env "$l" "$keep_branch"; cand_set "$l" state cleaned
  done
  # The promoted branch holds the winner's commits, so its tmp/ branch is only a leftover.
  local src target; target="$(mf_get '.winner.branch // empty')"
  if [ -n "$winner" ] && [ "$winner" != "$keep" ] && [ -n "$target" ]; then
    src="$(cand_get "$winner" '.branch')"
    case "$src" in tmp/*)
      if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$src" && git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$target" \
        && git -C "$REPO_DIR" merge-base --is-ancestor "$src" "$target"; then
        git -C "$REPO_DIR" branch -D "$src" >/dev/null && log "deleted branch $src (contained in $target)"
      fi ;;
    esac
  fi
  mf_update '.status = "cleaned"'
  [ "$purge" = "1" ] && { rm -rf "$ARENA_DIR"; log "purged $ARENA_DIR"; }
  return 0
}

cmd_list() { local m; shopt -s nullglob; for m in "$PROJECT"/arena/*/manifest.json; do jq -r '"\(.slug)\t\(.status)\t\(.candidates | length) candidates\t\(.task)"' "$m"; done; shopt -u nullglob; }


# ---------------------------------------------------------------------------
# Review: N independent reviewers on one diff (different harnesses/models), then a lead synthesis
# ---------------------------------------------------------------------------
review_launch() { # container harness model label host_dir container_dir prompt_text -> detached run in that container
  local container="$1" harness="$2" model="$3" label="$4" dir="$5" cdir="$6" prompt="$7" user cmd
  user="$(harness_user "$harness")"
  container_running "$container" || die "container $container is not running"
  printf '%s\n' "$prompt" > "$dir/$label-prompt.txt"
  rm -f "$dir/$label-run.json" "$dir/$label-run.log" "$dir/$label-run.exit" "$dir/$label.md"
  cmd="$(harness_cmd "$harness" "$model" "" "$cdir/$label-prompt.txt")"
  docker exec -d -u "$user" -w "$CONTAINER_ROOT" "$container" \
    bash -c "{ $cmd; } > $cdir/$label-run.json 2> $cdir/$label-run.log; echo \$? > $cdir/$label-run.exit"
  log "reviewer $label running in $container ($harness${model:+ $model})"
}

cmd_review() {
  local branch="" env="" patch="" reviewers="$AI_ARENA_REVIEWERS" reviewers_given=0 intent="" timeout="$AI_ARENA_TIMEOUT" arena="" prev=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --arena) arena="${2:?}"; shift 2 ;;
      --branch) branch="${2:?}"; shift 2 ;; --env) env="${2:?}"; shift 2 ;; --patch) patch="${2:?}"; shift 2 ;;
      --reviewers) reviewers="${2:?}"; reviewers_given=1; shift 2 ;; --intent) intent="${2:?}"; shift 2 ;; --timeout) timeout="${2:?}"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  local winner="" wspec=""
  if [ -n "$arena" ]; then
    # The arena's final code, in its promoted environment, read against the contract. Default
    # panel: a fresh session of the harness that wrote it plus the other candidates' harnesses.
    mf_require "$arena"
    env="$(mf_get '.winner.env_dir // empty')"; { [ -n "$env" ] && [ -d "$env" ]; } || die "arena $arena has no promoted environment (ai-arena promote $arena <winner> --env)"
    winner="$(mf_get '.winner.label')"
    wspec="$(mf_get '.final.harness // empty')"
    if [ -n "$wspec" ]; then wspec="$wspec:$(mf_get '.final.model // empty')"; else wspec="$(cand_get "$winner" '.harness'):$(cand_get "$winner" '.model // empty')"; fi
    [ "$reviewers_given" = 1 ] || reviewers="$(printf '%s\n' "$wspec" "$(xreviewers_for "$winner")" | grep -v '^$' | paste -sd, -)"
    prev="$(mf_get '.reviews // [] | last | .dir // empty')"
    cp "$ARENA_DIR/brief.md" "$env/arena-brief.md" 2>/dev/null || true
  fi
  [ -n "$branch$env$patch" ] || die "usage: review (--arena <slug> | --branch <b> | --env <dir> | --patch <file>) [--reviewers a,b] [--intent \"...\"]"
  local id dir tree_c
  id="review-$(date +%Y%m%d-%H%M%S)"; dir="$PROJECT/arena/reviews/$id"; mkdir -p "$dir"
  # The diff, and the tree reviewers may read for context (as the coordinator container sees it).
  if [ -n "$branch" ]; then
    git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$branch" || die "branch $branch does not exist in $REPO_DIR"
    git -C "$REPO_DIR" diff "$(git -C "$REPO_DIR" merge-base HEAD "$branch")" "$branch" > "$dir/diff.patch"
    tree_c="$CONTAINER_REPO"; [ -n "$intent" ] || intent="$(git -C "$REPO_DIR" log --format=%s "$(git -C "$REPO_DIR" merge-base HEAD "$branch")..$branch" | head -n 20)"
  elif [ -n "$env" ]; then
    env="$(cd "$env" && pwd)"; local wt="$env/$REPO_REL"
    [ -e "$wt/.git" ] || die "$wt is not a git checkout"
    tree_diff "$wt" > "$dir/diff.patch"
    case "$env" in "$PROJECT"/*) tree_c="$CONTAINER_ROOT/${env#"$PROJECT"/}/$REPO_REL" ;; *) tree_c="$CONTAINER_REPO" ;; esac
    [ -n "$intent" ] || [ -n "$arena" ] || intent="Working tree of $env"
  else
    [ -f "$patch" ] || die "patch file not found: $patch"; cp "$patch" "$dir/diff.patch"; tree_c="$CONTAINER_REPO"
    [ -n "$intent" ] || intent="Patch $(basename "$patch")"
  fi
  [ -s "$dir/diff.patch" ] || die "empty diff: nothing to review"
  if [ -n "$env" ]; then changed_files "$env/$REPO_REL" > "$dir/tree-before.txt"; fi
  # Reviewers of an environment work inside it, with its running site and database, when its
  # AI containers are up; otherwise (and for a branch or a patch) from the coordinator.
  local specs=() spec i=0 label labels=() prompt live=0 envn="" rdir="$dir" rcdir tree_r="$tree_c" runtime="$REVIEW_OFFLINE" where
  rcdir="$CONTAINER_ROOT/${dir#"$PROJECT"/}"
  IFS=',' read -r -a specs <<< "$reviewers"
  if [ -n "$env" ]; then
    envn="$(ddev_name "$env")"; live=1
    for spec in ${specs[@]+"${specs[@]}"}; do
      spec="$(printf '%s' "$spec" | tr -d '[:space:]')"; [ -n "$spec" ] || continue
      container_running "$(container_for "${spec%%:*}" "${envn:-none}")" || live=0
    done
    if [ "$live" = 1 ]; then
      rdir="$env/arena-review/$id"; rcdir="$CONTAINER_ROOT/arena-review/$id"; tree_r="$CONTAINER_ROOT/$REPO_REL"; runtime="$REVIEW_LIVE"
      mkdir -p "$rdir"; cp "$dir/diff.patch" "$rdir/diff.patch"
      log "reviewers run inside $envn, with its site and database"
    else
      warn "the AI containers of $env are not all running: reviewing from the coordinator, without the site (cd $env && ddev start for a live review)"
    fi
  fi
  if [ -n "$arena" ]; then
    local brief_c="$CONTAINER_ARENA/brief.md" note
    [ "$live" = 0 ] || brief_c="$CONTAINER_ROOT/arena-brief.md"
    note="Final code of arena $arena: the winning implementation plus what was ported from the others and the fixes the reviews asked for. The binding contract is $brief_c: check conformance with it besides correctness."
    if [ -n "$prev" ] && [ -f "$prev/verdict.md" ]; then
      cp "$prev/verdict.md" "$rdir/previous-verdict.md"; cp "$prev/diff.patch" "$rdir/previous-diff.patch" 2>/dev/null || true
      note+=" This code was reviewed before and then fixed. The previous verdict is $rcdir/previous-verdict.md and the diff it read is $rcdir/previous-diff.patch. First check that every item under Act on is really fixed. Then review in depth what changed since (compare that diff with this one), and the rest only for what the fixes could have broken."
    fi
    intent="$note${intent:+ $intent}"
  fi
  printf '%s\n' "$intent" > "$dir/intent.txt"; [ "$rdir" = "$dir" ] || cp "$dir/intent.txt" "$rdir/intent.txt"
  log "review $id: $(grep -c '^diff --git' "$dir/diff.patch") file(s) in the diff"
  # Fan out the reviewers (labels r1, r2, ...) in parallel, each blind to the others.
  for spec in ${specs[@]+"${specs[@]}"}; do
    spec="$(printf '%s' "$spec" | tr -d '[:space:]')"; [ -n "$spec" ] || continue
    local harness="${spec%%:*}" model=""; [ "$spec" != "$harness" ] && model="${spec#*:}"; harness_user "$harness" >/dev/null
    i=$((i + 1)); label="r$i"; labels+=("$label")
    where="$COORD"; [ "$live" = 0 ] || where="$envn"
    prompt="$(review_prompt "$rcdir/diff.patch" "$rcdir/intent.txt" "$tree_r" "$rcdir/$label.md" "$runtime")"
    review_launch "$(container_for "$harness" "$where")" "$harness" "$model" "$label" "$rdir" "$rcdir" "$prompt"
    jq -n --arg l "$label" --arg h "$harness" --arg m "$model" '{label:$l, harness:$h, model:(if $m=="" then null else $m end)}' >> "$dir/reviewers.jsonl"
  done
  [ "$i" -gt 0 ] || die "no reviewers"
  # Wait for every reviewer.
  local start pending l
  start="$(date +%s)"
  while :; do
    pending=0
    for l in "${labels[@]}"; do [ -f "$rdir/$l-run.exit" ] || pending=$((pending + 1)); done
    [ "$pending" = "0" ] && break
    if [ "$timeout" -gt 0 ] && [ $(( $(date +%s) - start )) -ge "$timeout" ]; then die "timeout: $pending reviewer(s) still running in $rdir"; fi
    sleep 10
  done
  if [ "$rdir" != "$dir" ]; then
    for l in "${labels[@]}"; do cp "$rdir/$l"-run.* "$dir/" 2>/dev/null || true; [ ! -f "$rdir/$l.md" ] || cp "$rdir/$l.md" "$dir/"; done
  fi
  for l in "${labels[@]}"; do
    if [ ! -s "$dir/$l.md" ]; then
      local h; h="$(jq -r --arg l "$l" 'select(.label==$l) | .harness' "$dir/reviewers.jsonl" | head -n1)"
      result_text "$h" "$dir/$l-run.json" > "$dir/$l.md" 2>/dev/null || true
      [ -s "$dir/$l.md" ] || printf 'NO REVIEW PRODUCED (exit %s)\n' "$(cat "$dir/$l-run.exit")" > "$dir/$l.md"
    fi
    log "reviewer $l: $(grep -c -E '^\s*-\s|^[0-9]+\.' "$dir/$l.md" || true) lines of findings"
  done
  # Lead synthesis in the PM harness (blind to which model wrote which review), in the
  # coordinator, which sees the review folder at $cdir.
  local harness model user container pfile out logf cmd cdir="$CONTAINER_ROOT/${dir#"$PROJECT"/}"
  harness="$AI_ARENA_PM_HARNESS"; model="$AI_ARENA_PM_MODEL"; user="$(harness_user "$harness")"; container="$(container_for "$harness" "$COORD")"
  container_running "$container" || die "container $container is not running (ai-arena up)"
  { sed -e "s|{{DIFF}}|$cdir/diff.patch|g" -e "s|{{INTENT}}|$cdir/intent.txt|g" -e "s|{{TREE}}|$tree_c|g" -e "s|{{VERDICT}}|$cdir/verdict.md|g" -e "s|{{REVIEWS}}|$(printf '%s ' "${labels[@]/#/$cdir/}" | sed 's/ $//; s|\([^ ]*\)|\1.md|g')|g" "$PROMPTS_DIR/review-lead.md"; } > "$dir/lead-prompt.txt"
  pfile="$cdir/lead-prompt.txt"; out="$dir/lead-run.json"; logf="$dir/lead-run.log"
  cmd="$(harness_cmd "$harness" "$model" "" "$pfile")"
  log "lead synthesis ($harness${model:+ $model}) ..."
  docker exec -u "$user" -w "$CONTAINER_ROOT" "$container" bash -c "$cmd" < /dev/null > "$out" 2> "$logf" || warn "lead call exited non-zero; see $logf"
  [ -s "$dir/verdict.md" ] || result_text "$harness" "$out" > "$dir/verdict.md" 2>/dev/null || true
  if [ -n "$env" ]; then
    # Reviewers read the tree, they must not write in it: anything new here would reach the branch.
    changed_files "$env/$REPO_REL" > "$dir/tree-after.txt"
    if [ -n "$(undeclared_files "$dir/tree-after.txt" "$dir/tree-before.txt")" ]; then
      warn "the review left files in $env/$REPO_REL (remove them before promoting):"
      undeclared_files "$dir/tree-after.txt" "$dir/tree-before.txt" >&2
    fi
  fi
  [ -z "$arena" ] || mf_update --arg d "$dir" --arg h "$(tree_diff "$env/$REPO_REL" | sha256sum | cut -d' ' -f1)" --arg t "$(now)" \
    '.reviews = ((.reviews // []) + [{dir:$d, diff_sha:$h, at:$t}])'
  echo "review: $dir"
  echo "reviewers: $(jq -r '[.label + "=" + .harness + ":" + (.model // "default")] | join(" ")' "$dir/reviewers.jsonl" | tr '\n' ' ')"
  echo "---"
  cat "$dir/verdict.md"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
PROJECT=""
while [ $# -gt 0 ]; do case "$1" in --project) PROJECT="$2"; shift 2 ;; *) break ;; esac; done
cmd="${1:-}"; shift || true
case "$cmd" in ""|-h|--help|help) usage; exit 0 ;; --version) echo "$VERSION"; exit 0 ;; esac
need git; need jq; need ddev; need docker
resolve_project
case "$cmd" in
  doctor) cmd_doctor ;; up) cmd_up ;; init) cmd_init "$@" ;; plan) cmd_plan "$@" ;; draft) cmd_draft "$@" ;; merge) cmd_merge "$@" ;; graft) cmd_graft "$@" ;; spawn) cmd_spawn "$@" ;; run) cmd_run "$@" ;;
  wait) cmd_wait "$@" ;; stop) cmd_stop "$@" ;; status) cmd_status "$@" ;; resume) cmd_resume "$@" ;; pm) cmd_pm "$@" ;; gate) cmd_gate "$@" ;;
  collect) cmd_collect "$@" ;; compare) cmd_compare "$@" ;; judge) cmd_judge "$@" ;; promote) cmd_promote "$@" ;; reveal) cmd_reveal "$@" ;; clean) cmd_clean "$@" ;; list) cmd_list ;; review) cmd_review "$@" ;;
  *) die "unknown command '$cmd' (see ai-arena --help)" ;;
esac
