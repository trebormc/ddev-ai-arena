#!/usr/bin/env bash

#ddev-generated
## Description: Arena of parallel AI candidates in isolated worktree environments, judged by a project-manager session
## Usage: ai-arena <command> [args]
## Example: "ddev ai-arena init 'Add a handling fee' --candidates claude:opus,opencode" then "ddev ai-arena spawn add-a-handling-fee"
## ExecRaw: true

# ai-arena runs ON THE HOST (it needs git, ddev and docker). It never gives a
# container Docker access. Every LLM step runs inside the project's own AI
# containers (Claude Code / OpenCode) through docker exec; every mechanical
# step is a deterministic subcommand below, so the host agent that drives an
# arena picks verbs and reads JSON instead of improvising shell.
#
# Layouts supported (detected from the DDEV project root, $DDEV_APPROOT):
#   A) standard      — the repo IS the project root (.ddev inside the repo)
#   B) env-directory — the project root holds .ddev, .beads, CLAUDE.md... and
#                      the repo lives in ONE subdirectory (docroot: app/web)
# Candidate environments are created as SIBLING directories of the project
# root, named <sitename>-tmp-<slug>-<label>, on branches tmp/<slug>-<label>.
# The winner is promoted to feature/<slug>. Only tmp/* branches and
# *-tmp-* environments are ever deleted by this tool.

set -euo pipefail

VERSION="0.1.0"
APPROOT="${DDEV_APPROOT:?ai-arena must run as a ddev host command}"
SITENAME="${DDEV_SITENAME:?ai-arena must run as a ddev host command}"
ENV_FILE="$APPROOT/.ddev/.env.ai-arena"
PROMPTS_DIR="$APPROOT/.ddev/ai-arena/prompts"
CONTAINER_ROOT="/var/www/html"
WINS_LOG="${HOME}/.ddev/ai-arena/wins.tsv"

# ---------------------------------------------------------------------------
# Defaults, then .ddev/.env.ai-arena
# ---------------------------------------------------------------------------
AI_ARENA_DEFAULT_CANDIDATES="claude:opus,claude:sonnet,opencode"
AI_ARENA_PM_HARNESS="claude"
AI_ARENA_PM_MODEL=""
AI_ARENA_MAX_CANDIDATES=3
AI_ARENA_TIMEOUT=7200
AI_ARENA_BASE_REF="HEAD"
AI_ARENA_DB_SNAPSHOT="baseline"
AI_ARENA_DB_FILE=""
AI_ARENA_LOCAL_FILES=""
AI_ARENA_SPAWN_HOOK=""
AI_ARENA_REMOVE_HOOK=""
AI_ARENA_PROVISION="drush cr; drush updb -y; drush cim -y; drush cim -y"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
log()  { printf '==> %s\n' "$*" >&2; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required on the host PATH"; }

slugify() {
  # lowercase, non-alphanumerics to '-', at most 32 chars cut on a word boundary
  local s
  s="$(printf '%s' "$1" | { iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null || cat; } \
      | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  if [ ${#s} -gt 32 ]; then
    s="${s:0:32}"
    case "$s" in *-*) s="${s%-*}" ;; esac
  fi
  printf '%s' "$s" | sed -E 's/-+$//'
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

usage() {
  cat <<EOF
ai-arena $VERSION — parallel AI candidates in isolated worktree environments

Usage: ddev ai-arena <command> [args]

Lifecycle (run from the MAIN project directory):
  doctor                                   Check host tools, containers and layout
  init "<task>" [--candidates a,b] [--pm harness[:model]] [--description "..."]
                                           Create arena/<slug>/manifest.json
  plan <slug> ["description"]              Ask the PM session to write arena/<slug>/brief.md
  spawn <slug> [label...]                  Create candidate environments (worktree + DDEV + DB)
  run <slug> [label...]                    Start candidates (detached) on the brief
  wait <slug> [--all] [--timeout S]        Block until a candidate changes state (or all finish)
  status <slug> [--json]                   Show candidate states
  resume <slug> <label> "<message>"        Continue a candidate's session with a message
  pm <slug> "<message>"                    Send a message to the PM session, print its verdict
  gate <slug> [label...]                   Run mechanical gates (site, phpstan, phpcs, phpunit)
  collect <slug>                           Gather diffs, reports and gates into arena/<slug>/candidates/
  judge <slug>                             Ask the PM to judge the collected candidates (blind)
  promote <slug> <label> [--branch name] [--env]
                                           Create feature/<slug> from the winner (optionally its environment)
  reveal <slug>                            Show label -> harness/model and log the win
  clean <slug> [--keep label] [--purge]    Delete candidate environments, worktrees and tmp/ branches
  list                                     List arenas in this project

Config: .ddev/.env.ai-arena
EOF
}

# ---------------------------------------------------------------------------
# Layout
# ---------------------------------------------------------------------------
detect_layout() {
  REPO_REL=""
  if [ ! -e "$APPROOT/.git" ]; then
    local d
    for d in "$APPROOT"/*/; do
      [ -e "${d}.git" ] || continue
      REPO_REL="$(basename "$d")"
      break
    done
    [ -n "$REPO_REL" ] || die "no git repository found in $APPROOT or its direct subdirectories"
  fi
  REPO_DIR="$APPROOT${REPO_REL:+/$REPO_REL}"
  ENV_PARENT="$(dirname "$APPROOT")"
  CONTAINER_REPO="$CONTAINER_ROOT${REPO_REL:+/$REPO_REL}"
}

# ---------------------------------------------------------------------------
# Manifest
# ---------------------------------------------------------------------------
arena_dir()  { printf '%s/arena/%s' "$APPROOT" "$1"; }
manifest()   { printf '%s/manifest.json' "$(arena_dir "$1")"; }

mf_require() {
  SLUG="$1"
  ARENA_DIR="$(arena_dir "$SLUG")"
  MANIFEST="$(manifest "$SLUG")"
  [ -f "$MANIFEST" ] || die "no arena '$SLUG' (expected $MANIFEST). Run: ddev ai-arena init"
  CONTAINER_ARENA="$CONTAINER_ROOT/arena/$SLUG"
}

mf_get() { jq -r "$1" "$MANIFEST"; }

mf_update() {
  local tmp
  tmp="$(mktemp)"
  jq "$@" "$MANIFEST" > "$tmp" && mv "$tmp" "$MANIFEST"
}

cand_get() { # label jq-expr
  jq -r --arg l "$1" ".candidates[] | select(.label==\$l) | $2" "$MANIFEST"
}

cand_set() { # label key value
  mf_update --arg l "$1" --arg k "$2" --arg v "$3" \
    '(.candidates[] | select(.label==$l))[$k] = $v | .updated = now | .updated |= (todate)'
}

cand_set_json() { # label key json
  mf_update --arg l "$1" --arg k "$2" --argjson v "$3" \
    '(.candidates[] | select(.label==$l))[$k] = $v'
}

labels() { jq -r '.candidates[].label' "$MANIFEST"; }

resolve_labels() { # [label...] -> all if none
  if [ $# -eq 0 ]; then labels; else printf '%s\n' "$@"; fi
}

guard_label() {
  local l="$1"
  jq -e --arg l "$l" '.candidates[] | select(.label==$l)' "$MANIFEST" >/dev/null || die "unknown candidate label '$l'"
}

# ---------------------------------------------------------------------------
# Harness plumbing (all LLM work happens inside the AI containers)
# ---------------------------------------------------------------------------
harness_user() {
  case "$1" in
    claude) echo claude ;;
    opencode) echo opencode ;;
    *) die "unknown harness '$1' (use claude or opencode)" ;;
  esac
}

container_for() { # harness env_name
  case "$1" in
    claude) echo "ddev-$2-claude-code" ;;
    opencode) echo "ddev-$2-opencode" ;;
    *) die "unknown harness '$1'" ;;
  esac
}

container_running() {
  docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$1"
}

# Command line executed INSIDE the container. The prompt is read from a file
# so no quoting leaks; the session id is passed only when resuming.
harness_cmd() { # harness model session prompt_file_in_container
  local harness="$1" model="$2" session="$3" pfile="$4" cmd
  case "$harness" in
    claude)
      cmd="claude -p --output-format json --permission-mode bypassPermissions"
      [ -n "$model" ] && cmd="$cmd --model '$model'"
      [ -n "$session" ] && cmd="$cmd --resume '$session'"
      ;;
    opencode)
      cmd="opencode run --format json"
      [ -n "$model" ] && cmd="$cmd -m '$model'"
      [ -n "$session" ] && cmd="$cmd -s '$session'"
      ;;
  esac
  printf '%s "$(cat %s)"' "$cmd" "$pfile"
}

# Session id from a harness's JSON output.
session_from_output() { # harness file
  case "$1" in
    claude) jq -r 'if type=="array" then (.[] | select(.session_id?) | .session_id) else (.session_id // empty) end' "$2" 2>/dev/null | head -n1 ;;
    opencode) grep -o '"sessionID":"[^"]*"' "$2" 2>/dev/null | head -n1 | cut -d'"' -f4 ;;
  esac
}

# Assistant text from a harness's JSON output (best effort; raw on failure).
result_text() { # harness file
  case "$1" in
    claude) jq -r 'if type=="array" then (.[] | select(.result?) | .result) else (.result // empty) end' "$2" 2>/dev/null || cat "$2" ;;
    opencode)
      if jq -e . "$2" >/dev/null 2>&1 || jq -e -s . "$2" >/dev/null 2>&1; then
        jq -r 'select(.type=="text" or .type=="message.part.updated") | (.part.text // .text // empty)' "$2" 2>/dev/null | grep -v '^$' || cat "$2"
      else
        cat "$2"
      fi
      ;;
  esac
}

# Parse the structured trailer a PM reply ends with:
#   VERDICT: ANSWER|REDISPATCH|ASK_USER|DONE|JUDGED|BLOCKED
#   TO: <label|all|user>      WINNER: <label>
#   MESSAGE: <text until end>
parse_verdict() { # text_file -> json
  local f="$1" verdict to winner message
  verdict="$(grep -E '^VERDICT:' "$f" | tail -n1 | sed -E 's/^VERDICT:[[:space:]]*//' || true)"
  to="$(grep -E '^TO:' "$f" | tail -n1 | sed -E 's/^TO:[[:space:]]*//' || true)"
  winner="$(grep -E '^WINNER:' "$f" | tail -n1 | sed -E 's/^WINNER:[[:space:]]*//' || true)"
  message="$(awk 'found{print} /^MESSAGE:/{found=1; sub(/^MESSAGE:[[:space:]]*/, ""); print}' "$f" || true)"
  jq -n --arg verdict "$verdict" --arg to "$to" --arg winner "$winner" --arg message "$message" \
    --rawfile raw "$f" '{verdict:$verdict, to:$to, winner:$winner, message:$message, raw:$raw}'
}

# Synchronous call to the PM session in THIS project's AI container.
pm_call() { # message_text -> prints JSON verdict; stores session
  local harness model session container user pfile out log cmd text
  harness="$(mf_get '.pm.harness')"
  model="$(mf_get '.pm.model // empty')"
  session="$(mf_get '.pm.session // empty')"
  user="$(harness_user "$harness")"
  container="$(container_for "$harness" "$SITENAME")"
  container_running "$container" || die "container $container is not running (ddev start in the main project)"
  mkdir -p "$ARENA_DIR/pm"
  pfile="$ARENA_DIR/pm/prompt-$(date +%s).txt"
  out="${pfile%.txt}.json"
  log="${pfile%.txt}.log"
  if [ -z "$session" ]; then
    { sed -e "s|{{SLUG}}|$SLUG|g" -e "s|{{ARENA}}|$CONTAINER_ARENA|g" -e "s|{{REPO}}|$CONTAINER_REPO|g" "$PROMPTS_DIR/pm.md"; printf '\n\n'; printf '%s\n' "$1"; } > "$pfile"
  else
    printf '%s\n' "$1" > "$pfile"
  fi
  cmd="$(harness_cmd "$harness" "$model" "$session" "$CONTAINER_ARENA/pm/$(basename "$pfile")")"
  log "pm ($harness${model:+ $model}${session:+, resumed}) ..."
  if ! docker exec -i -u "$user" -w "$CONTAINER_ROOT" "$container" bash -c "$cmd" > "$out" 2> "$log"; then
    warn "pm call exited non-zero; see $log"
  fi
  if [ -z "$session" ]; then
    session="$(session_from_output "$harness" "$out")"
    [ -n "$session" ] && mf_update --arg s "$session" '.pm.session = $s'
  fi
  text="${pfile%.txt}.md"
  result_text "$harness" "$out" > "$text"
  parse_verdict "$text"
}

# ---------------------------------------------------------------------------
# Environment creation (candidate worktree + DDEV project + database)
# ---------------------------------------------------------------------------
copy_local_files() { # src_repo dst_repo
  local src="$1" dst="$2" rel n=0
  local patterns=('**/settings.local.php' '**/development.services.yml' '**/dev.services.yml'
                  '**/devel-twig.services.yml' '**/services.redis.yml' '**/.claude/settings.local.json'
                  '.claude/settings.local.json')
  # shellcheck disable=SC2206
  [ -n "$AI_ARENA_LOCAL_FILES" ] && patterns+=($AI_ARENA_LOCAL_FILES)
  while IFS= read -r -d '' rel; do
    case "$rel" in vendor/*|*/vendor/*|node_modules/*|*/node_modules/*|*/core/*|*/files/*) continue ;; esac
    [ -e "$dst/$rel" ] && continue
    mkdir -p "$(dirname "$dst/$rel")"
    cp -a "$src/$rel" "$dst/$rel"
    n=$((n + 1))
  done < <(git -C "$src" ls-files --others -z -- "${patterns[@]}" 2>/dev/null)
  log "copied $n local config file(s)"
}

clean_ddev_state() { # env .ddev dir
  local d="$1"
  rm -rf "$d"/.ddev-docker-compose-*.yaml "$d/.global_commands" "$d/.homeadditions" \
         "$d/.dbimageBuild" "$d/.webimageBuild" "$d"/.importdb* "$d/db_snapshots" "$d/.agent-ssh-keys" 2>/dev/null || true
}

write_model_override() { # env_dir harness model label
  local f="$1/.ddev/.env.agents"
  [ -n "$3" ] || return 0
  mkdir -p "$1/.ddev"
  {
    printf '\n# ai-arena candidate %s (%s)\n' "$4" "$2"
    case "$2" in
      claude)   printf 'CC_MODEL_MAIN=%s\nCC_MODEL_NORMAL=%s\n' "$3" "$3" ;;
      opencode) printf 'OC_MODEL_MAIN=%s\nOC_MODEL_NORMAL=%s\n' "$3" "$3" ;;
    esac
  } >> "$f"
}

provision_db() { # env_dir
  local env="$1" snaps=()
  shopt -s nullglob
  snaps=("$APPROOT/.ddev/db_snapshots/${AI_ARENA_DB_SNAPSHOT}"*)
  shopt -u nullglob
  if [ -n "$AI_ARENA_DB_SNAPSHOT" ] && [ ${#snaps[@]} -gt 0 ]; then
    log "restoring snapshot '$AI_ARENA_DB_SNAPSHOT' from the main project"
    mkdir -p "$env/.ddev/db_snapshots"
    local s
    for s in "${snaps[@]}"; do
      ln "$s" "$env/.ddev/db_snapshots/$(basename "$s")" 2>/dev/null || cp -a "$s" "$env/.ddev/db_snapshots/"
    done
    if (cd "$env" && ddev snapshot restore "$AI_ARENA_DB_SNAPSHOT"); then return 0; fi
    warn "snapshot restore failed, falling back"
  fi
  if [ -n "$AI_ARENA_DB_FILE" ]; then
    [ -f "$AI_ARENA_DB_FILE" ] || die "AI_ARENA_DB_FILE not found: $AI_ARENA_DB_FILE"
    log "importing $AI_ARENA_DB_FILE"
    (cd "$env" && ddev import-db --file="$AI_ARENA_DB_FILE")
    return 0
  fi
  local dump="$ARENA_DIR/db.sql.gz"
  if [ ! -f "$dump" ]; then
    log "exporting the main project's database once for this arena"
    (cd "$APPROOT" && ddev export-db --file="$dump" --gzip)
  fi
  log "importing $dump"
  (cd "$env" && ddev import-db --file="$dump")
}

run_provision_steps() { # env_dir
  local env="$1" step
  IFS=';' read -r -a steps <<< "$AI_ARENA_PROVISION"
  for step in "${steps[@]}"; do
    step="$(printf '%s' "$step" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
    [ -n "$step" ] || continue
    log "provision: ddev $step"
    # shellcheck disable=SC2086
    (cd "$env" && ddev $step) || warn "provision step failed: ddev $step"
  done
}

create_env() { # branch env_name env_dir label harness model
  local branch="$1" env_name="$2" env_dir="$3" label="$4" harness="${5:-}" model="${6:-}" wt_repo
  [ -e "$env_dir" ] && die "$env_dir already exists (ddev ai-arena clean first)"
  if [ -n "$AI_ARENA_SPAWN_HOOK" ]; then
    local hook="$AI_ARENA_SPAWN_HOOK"
    hook="${hook//\{branch\}/$branch}"; hook="${hook//\{env_name\}/$env_name}"; hook="${hook//\{env_dir\}/$env_dir}"
    hook="${hook//\{approot\}/$APPROOT}"; hook="${hook//\{label\}/$label}"
    log "spawn hook: $hook"
    bash -c "$hook"
    [ -d "$env_dir" ] || die "spawn hook did not create $env_dir"
    write_model_override "$env_dir" "$harness" "$model" "$label"
    return 0
  fi
  mkdir -p "$env_dir"
  local wt_args=()
  if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$branch"; then
    wt_args=("$branch")
  else
    wt_args=(-b "$branch" "$AI_ARENA_BASE_REF")
  fi
  if [ -z "$REPO_REL" ]; then
    # Layout A: the worktree is the environment.
    rmdir "$env_dir"
    log "git worktree add $env_dir ($branch)"
    git -C "$REPO_DIR" worktree add "$env_dir" "${wt_args[@]}"
    wt_repo="$env_dir"
    mkdir -p "$env_dir/.ddev"
    # Untracked/ignored .ddev files (env files, local overrides) come along.
    local rel
    while IFS= read -r -d '' rel; do
      [ -e "$env_dir/$rel" ] && continue
      mkdir -p "$(dirname "$env_dir/$rel")"
      cp -a "$REPO_DIR/$rel" "$env_dir/$rel"
    done < <(git -C "$REPO_DIR" ls-files --others -z -- '.ddev/**' 2>/dev/null)
    clean_ddev_state "$env_dir/.ddev"
    printf '#ddev-generated by ai-arena\nname: %s\n' "$env_name" > "$env_dir/.ddev/config.arena.yaml"
    if grep -qE '^host_(db|webserver|https)_port:' "$env_dir/.ddev/config.yaml" 2>/dev/null; then
      warn "config.yaml pins host ports; the candidate may fail to start (unpin them in the main project)"
    fi
  else
    # Layout B: copy the environment directory except the repo and arena data.
    local item name
    shopt -s dotglob nullglob
    for item in "$APPROOT"/*; do
      name="$(basename "$item")"
      case "$name" in "$REPO_REL"|arena|arena-*) continue ;; esac
      cp -a "$item" "$env_dir/"
    done
    shopt -u dotglob nullglob
    clean_ddev_state "$env_dir/.ddev"
    sed -i -E '/^name:[[:space:]]/d; /^host_(db|webserver|https)_port:[[:space:]]/d' "$env_dir/.ddev/config.yaml"
    printf 'name: %s\n' "$env_name" >> "$env_dir/.ddev/config.yaml"
    wt_repo="$env_dir/$REPO_REL"
    log "git worktree add $wt_repo ($branch)"
    git -C "$REPO_DIR" worktree add "$wt_repo" "${wt_args[@]}"
  fi
  copy_local_files "$REPO_DIR" "$wt_repo"
  write_model_override "$env_dir" "$harness" "$model" "$label"
  log "ddev start ($env_name)"
  (cd "$env_dir" && ddev start -y)
  log "composer install"
  (cd "$env_dir" && ddev composer install --no-interaction) || warn "composer install failed in $env_name"
  provision_db "$env_dir"
  run_provision_steps "$env_dir"
}

remove_env() { # env_name env_dir branch keep_branch(0|1)
  local env_name="$1" env_dir="$2" branch="$3" keep="$4" wt_repo
  case "$env_name" in "${SITENAME}-tmp-"*) ;; *) die "refusing to remove '$env_name': not an arena environment" ;; esac
  case "$env_dir" in "$ENV_PARENT/${SITENAME}-tmp-"*) ;; *) die "refusing to remove '$env_dir': outside $ENV_PARENT" ;; esac
  case "$branch" in tmp/*) ;; *) die "refusing to delete branch '$branch': not tmp/*" ;; esac
  [ "$env_dir" != "$APPROOT" ] || die "refusing to remove the main project"
  if [ -n "$AI_ARENA_REMOVE_HOOK" ]; then
    local hook="$AI_ARENA_REMOVE_HOOK"
    hook="${hook//\{branch\}/$branch}"; hook="${hook//\{env_name\}/$env_name}"; hook="${hook//\{env_dir\}/$env_dir}"
    hook="${hook//\{approot\}/$APPROOT}"
    log "remove hook: $hook"
    bash -c "$hook" || warn "remove hook failed"
  else
    log "ddev delete $env_name"
    ddev delete -Oy "$env_name" >/dev/null 2>&1 || warn "ddev delete failed or project not registered ($env_name)"
    wt_repo="$env_dir${REPO_REL:+/$REPO_REL}"
    if [ -e "$wt_repo/.git" ]; then
      git -C "$REPO_DIR" worktree remove --force "$wt_repo" || warn "worktree remove failed for $wt_repo"
    fi
    git -C "$REPO_DIR" worktree prune
    [ -d "$env_dir" ] && rm -rf "$env_dir"
  fi
  if [ "$keep" = "0" ] && git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$REPO_DIR" branch -D "$branch" >/dev/null && log "deleted branch $branch"
  fi
}

# ---------------------------------------------------------------------------
# Candidate run / wait
# ---------------------------------------------------------------------------
launch_candidate() { # label prompt_text resume(0|1)
  local label="$1" prompt="$2" resume="$3"
  local harness model session env_name env_dir container user cmd
  harness="$(cand_get "$label" '.harness')"
  model="$(cand_get "$label" '.model // empty')"
  session="$(cand_get "$label" '.session // empty')"
  env_name="$(cand_get "$label" '.env_name')"
  env_dir="$(cand_get "$label" '.env_dir')"
  [ -d "$env_dir" ] || die "candidate $label has no environment (ddev ai-arena spawn $SLUG $label)"
  user="$(harness_user "$harness")"
  container="$(container_for "$harness" "$env_name")"
  container_running "$container" || die "container $container is not running (cd $env_dir && ddev start)"
  [ "$resume" = "1" ] || session=""
  rm -f "$env_dir/arena-report.md" "$env_dir/arena-run.json" "$env_dir/arena-run.log" "$env_dir/arena-run.exit"
  printf '%s\n' "$prompt" > "$env_dir/arena-prompt.txt"
  cmd="$(harness_cmd "$harness" "$model" "$session" "$CONTAINER_ROOT/arena-prompt.txt")"
  docker exec -d -u "$user" -w "$CONTAINER_ROOT" "$container" \
    bash -c "{ $cmd; } > $CONTAINER_ROOT/arena-run.json 2> $CONTAINER_ROOT/arena-run.log; echo \$? > $CONTAINER_ROOT/arena-run.exit"
  cand_set "$label" state running
  cand_set "$label" started "$(now)"
  log "candidate $label running in $container ($harness${model:+ $model}${session:+, resumed})"
}

# Reads a finished candidate's artifacts and updates its state. Prints new state.
settle_candidate() { # label
  local label="$1" env_dir harness exit_code report status session
  env_dir="$(cand_get "$label" '.env_dir')"
  harness="$(cand_get "$label" '.harness')"
  [ -f "$env_dir/arena-run.exit" ] || { echo running; return 0; }
  exit_code="$(cat "$env_dir/arena-run.exit")"
  session="$(session_from_output "$harness" "$env_dir/arena-run.json")"
  [ -n "$session" ] && cand_set "$label" session "$session"
  report="$env_dir/arena-report.md"
  if [ -f "$report" ]; then
    status="$(grep -E '^STATUS:' "$report" | head -n1 | sed -E 's/^STATUS:[[:space:]]*//' | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"
  fi
  case "${status:-}" in
    DONE|BLOCKED|FAILED|PARTIAL) ;;
    *) status="FAILED"; [ "$exit_code" = "0" ] && [ ! -f "$report" ] && status="FAILED" ;;
  esac
  cand_set "$label" state "$status"
  cand_set "$label" exit_code "$exit_code"
  cand_set "$label" finished "$(now)"
  echo "$status"
}

status_json() {
  jq '{slug, status, description, pm:{harness:.pm.harness, model:.pm.model, session:(.pm.session != null)},
       candidates:[.candidates[] | {label, harness, model, branch, env_name, env_dir, state, exit_code, session:(.session != null), gates}],
       judge}' "$MANIFEST"
}

status_table() {
  printf '%-6s %-9s %-28s %-9s %-8s %s\n' LABEL HARNESS MODEL STATE GATES BRANCH
  jq -r '.candidates[] | [.label, .harness, (.model // "(default)"), .state,
          (if .gates then ([.gates | to_entries[] | select(.key != "logs") | .value] | map(select(. == "fail")) | length | if . == 0 then "pass" else "fail" end) else "-" end),
          .branch] | @tsv' "$MANIFEST" | while IFS=$'\t' read -r l h m s g b; do
    printf '%-6s %-9s %-28s %-9s %-8s %s\n' "$l" "$h" "$m" "$s" "$g" "$b"
  done
}

# ---------------------------------------------------------------------------
# Gates
# ---------------------------------------------------------------------------
changed_files() { # wt_repo -> list (tracked changes + untracked, excluding arena artefacts)
  local wt="$1"
  { git -C "$wt" diff --name-only HEAD; git -C "$wt" ls-files --others --exclude-standard; } 2>/dev/null \
    | grep -vE '^(arena-|\.ddev/config\.arena\.yaml$|arena/)' | sort -u
}

run_gate() { # env_dir container_dir logfile cmd... -> pass|fail
  local env="$1" cdir="$2" logf="$3"; shift 3
  if (cd "$env" && ddev exec -d "$cdir" "$@") > "$logf" 2>&1; then echo pass; else echo fail; fi
}

gate_candidate() { # label
  local label="$1" env_dir wt_repo cdir gdir site phpstan phpcs phpunit targets docroot t
  env_dir="$(cand_get "$label" '.env_dir')"
  wt_repo="$env_dir${REPO_REL:+/$REPO_REL}"
  cdir="$CONTAINER_REPO"
  gdir="$ARENA_DIR/candidates/$label/gates"
  mkdir -p "$gdir"
  log "gates for $label"
  site="fail"
  if (cd "$env_dir" && ddev drush status --field=bootstrap) 2>"$gdir/site.log" | grep -q Successful; then site="pass"; fi
  changed_files "$wt_repo" > "$gdir/changed-files.txt"
  targets="$(sed -nE 's#^(.*/)?((modules|themes|profiles)/custom/[^/]+)/.*#\2#p' "$gdir/changed-files.txt" | sort -u)"
  docroot="$(sed -nE 's#^(.*/)?(modules|themes|profiles)/custom/[^/]+/.*#\1#p' "$gdir/changed-files.txt" | sort -u | head -n1)"
  phpstan="skip"; phpcs="skip"; phpunit="skip"
  if [ -n "$targets" ]; then
    # shellcheck disable=SC2086
    local tpaths=$(for t in $targets; do printf '%s%s ' "$docroot" "$t"; done)
    if (cd "$env_dir" && ddev exec -d "$cdir" test -x vendor/bin/phpstan) >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      phpstan="$(run_gate "$env_dir" "$cdir" "$gdir/phpstan.log" vendor/bin/phpstan analyse --no-progress --no-interaction $tpaths)"
    fi
    if (cd "$env_dir" && ddev exec -d "$cdir" test -x vendor/bin/phpcs) >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      phpcs="$(run_gate "$env_dir" "$cdir" "$gdir/phpcs.log" vendor/bin/phpcs --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,test,profile,theme $tpaths)"
    fi
    if (cd "$env_dir" && ddev exec -d "$cdir" test -x vendor/bin/phpunit) >/dev/null 2>&1; then
      local any=0 res
      for t in $targets; do
        [ -d "$wt_repo/$docroot$t/tests" ] || continue
        any=1
        if [ -f "$wt_repo/phpunit.xml" ] || [ -f "$wt_repo/phpunit.xml.dist" ]; then
          res="$(run_gate "$env_dir" "$cdir" "$gdir/phpunit-$(basename "$t").log" vendor/bin/phpunit "$docroot$t/tests")"
        else
          res="$(run_gate "$env_dir" "$cdir" "$gdir/phpunit-$(basename "$t").log" env SIMPLETEST_DB=mysql://db:db@db/db SIMPLETEST_BASE_URL=http://localhost vendor/bin/phpunit -c "${docroot}core" "$docroot$t/tests")"
        fi
        [ "$res" = "fail" ] && phpunit="fail"
        [ "$res" = "pass" ] && [ "$phpunit" != "fail" ] && phpunit="pass"
      done
      [ "$any" = "1" ] || phpunit="skip"
    fi
  fi
  jq -n --arg site "$site" --arg phpstan "$phpstan" --arg phpcs "$phpcs" --arg phpunit "$phpunit" \
    --arg logs "$gdir" --arg targets "$targets" \
    '{site:$site, phpstan:$phpstan, phpcs:$phpcs, phpunit:$phpunit, targets:($targets | split("\n") | map(select(. != ""))), logs:$logs}' \
    > "$gdir/../gates.json"
  cand_set_json "$label" gates "$(jq 'del(.logs)' "$gdir/../gates.json")"
  jq -c . "$gdir/../gates.json"
}

collect_candidate() { # label
  local label="$1" env_dir wt_repo cdir f
  env_dir="$(cand_get "$label" '.env_dir')"
  wt_repo="$env_dir${REPO_REL:+/$REPO_REL}"
  cdir="$ARENA_DIR/candidates/$label"
  mkdir -p "$cdir"
  {
    git -C "$wt_repo" diff HEAD -- . ':(exclude)arena-*' 2>/dev/null || true
    git -C "$wt_repo" ls-files --others --exclude-standard | grep -vE '^(arena-|\.ddev/config\.arena\.yaml$)' | while IFS= read -r f; do
      git -C "$wt_repo" diff --no-index -- /dev/null "$f" 2>/dev/null || true
    done
  } > "$cdir/diff.patch"
  changed_files "$wt_repo" > "$cdir/files-changed.txt"
  if [ -f "$env_dir/arena-report.md" ]; then cp "$env_dir/arena-report.md" "$cdir/report.md"; else printf 'STATUS: FAILED\n(no report written)\n' > "$cdir/report.md"; fi
  [ -f "$env_dir/arena-run.log" ] && cp "$env_dir/arena-run.log" "$cdir/run.log"
  # No harness or model information lands here: the judge stays blind.
  log "collected $label: $(wc -l < "$cdir/files-changed.txt") file(s) changed"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_doctor() {
  detect_layout
  local ok=0 t
  for t in git jq ddev docker; do
    if command -v "$t" >/dev/null 2>&1; then echo "ok    $t: $(command -v "$t")"; else echo "MISSING $t"; ok=1; fi
  done
  echo "ok    layout: $([ -z "$REPO_REL" ] && echo 'A (repo is the project root)' || echo "B (repo in $REPO_REL/)")"
  echo "ok    project: $SITENAME at $APPROOT (candidates go to $ENV_PARENT/${SITENAME}-tmp-*)"
  [ -f "$ENV_FILE" ] && echo "ok    config: $ENV_FILE" || echo "warn  no $ENV_FILE (defaults in use)"
  [ -d "$PROMPTS_DIR" ] && echo "ok    prompts: $PROMPTS_DIR" || { echo "MISSING prompts dir $PROMPTS_DIR"; ok=1; }
  for t in claude opencode; do
    local c; c="$(container_for "$t" "$SITENAME")"
    if container_running "$c"; then
      local v; v="$(docker exec -u "$(harness_user "$t")" "$c" "$t" --version 2>/dev/null | head -n1 || echo '?')"
      echo "ok    $t container: $c ($v)"
    else
      echo "warn  $t container not running: $c"
    fi
  done
  shopt -s nullglob; local snaps=("$APPROOT/.ddev/db_snapshots/${AI_ARENA_DB_SNAPSHOT}"*); shopt -u nullglob
  [ ${#snaps[@]} -gt 0 ] && echo "ok    db snapshot '$AI_ARENA_DB_SNAPSHOT' available" || echo "info  no '$AI_ARENA_DB_SNAPSHOT' snapshot; candidates will import AI_ARENA_DB_FILE or an export"
  echo "info  free disk: $(df -h "$ENV_PARENT" | awk 'NR==2{print $4}')"
  return $ok
}

cmd_init() {
  detect_layout
  local task="" candidates="$AI_ARENA_DEFAULT_CANDIDATES" pm="${AI_ARENA_PM_HARNESS}${AI_ARENA_PM_MODEL:+:$AI_ARENA_PM_MODEL}" description="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --candidates) candidates="$2"; shift 2 ;;
      --pm) pm="$2"; shift 2 ;;
      --description) description="$2"; shift 2 ;;
      --force) force=1; shift ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$task" ] && task="$1" || description="$description $1"; shift ;;
    esac
  done
  [ -n "$task" ] || die "usage: init \"<task>\" [--candidates a,b] [--pm harness[:model]] [--description \"...\"]"
  [ -n "$description" ] || description="$task"
  local slug; slug="$(slugify "$task")"
  [ -n "$slug" ] || die "cannot derive a slug from '$task'"
  local dir; dir="$(arena_dir "$slug")"
  if [ -f "$dir/manifest.json" ] && [ "$force" = "0" ]; then die "arena '$slug' exists (use --force to recreate the manifest)"; fi
  mkdir -p "$dir/candidates" "$dir/pm"
  local pm_harness="${pm%%:*}" pm_model=""
  [ "$pm" != "$pm_harness" ] && pm_model="${pm#*:}"
  harness_user "$pm_harness" >/dev/null
  local specs=() spec i=0 label harness model cands="[]"
  IFS=',' read -r -a specs <<< "$candidates"
  [ ${#specs[@]} -le "$AI_ARENA_MAX_CANDIDATES" ] || die "too many candidates (${#specs[@]} > AI_ARENA_MAX_CANDIDATES=$AI_ARENA_MAX_CANDIDATES)"
  for spec in "${specs[@]}"; do
    spec="$(printf '%s' "$spec" | tr -d '[:space:]')"
    [ -n "$spec" ] || continue
    harness="${spec%%:*}"; model=""; [ "$spec" != "$harness" ] && model="${spec#*:}"
    harness_user "$harness" >/dev/null
    label="$(printf "\\$(printf '%03o' $((97 + i)))")"
    cands="$(jq --arg l "$label" --arg h "$harness" --arg m "$model" --arg b "tmp/$slug-$label" \
      --arg n "${SITENAME}-tmp-${slug}-${label}" --arg d "$ENV_PARENT/${SITENAME}-tmp-${slug}-${label}" \
      '. + [{label:$l, harness:$h, model:(if $m=="" then null else $m end), branch:$b, env_name:$n, env_dir:$d, state:"init", session:null, gates:null}]' <<< "$cands")"
    i=$((i + 1))
  done
  [ "$i" -gt 0 ] || die "no candidates"
  jq -n --arg slug "$slug" --arg task "$task" --arg description "$description" --arg created "$(now)" \
    --arg ph "$pm_harness" --arg pm "$pm_model" --arg site "$SITENAME" --arg approot "$APPROOT" --arg repo "$REPO_REL" --argjson c "$cands" \
    '{slug:$slug, task:$task, description:$description, status:"init", created:$created, project:$site, approot:$approot, repo_rel:$repo,
      pm:{harness:$ph, model:(if $pm=="" then null else $pm end), session:null}, candidates:$c, judge:null, winner:null}' \
    > "$dir/manifest.json"
  log "arena '$slug' created with $i candidate(s): $dir"
  echo "$slug"
}

cmd_plan() {
  detect_layout; mf_require "$1"; shift
  local description="${1:-$(mf_get '.description')}" msg
  msg="$(sed -e "s|{{SLUG}}|$SLUG|g" -e "s|{{ARENA}}|$CONTAINER_ARENA|g" -e "s|{{REPO}}|$CONTAINER_REPO|g" "$PROMPTS_DIR/plan.md")"
  msg="${msg//\{\{TASK\}\}/$description}"
  msg="${msg//\{\{CANDIDATES\}\}/$(labels | tr '\n' ' ')}"
  pm_call "$msg"
  [ -s "$ARENA_DIR/brief.md" ] || die "the PM did not write $ARENA_DIR/brief.md (see arena/$SLUG/pm/*.log)"
  mf_update '.status = "planned"'
  log "brief written: $ARENA_DIR/brief.md"
}

cmd_spawn() {
  detect_layout; mf_require "$1"; shift
  local l state
  for l in $(resolve_labels "$@"); do
    guard_label "$l"
    state="$(cand_get "$l" '.state')"
    [ "$state" = "init" ] || { warn "candidate $l is '$state', not init; skipping"; continue; }
    create_env "$(cand_get "$l" '.branch')" "$(cand_get "$l" '.env_name')" "$(cand_get "$l" '.env_dir')" "$l" \
      "$(cand_get "$l" '.harness')" "$(cand_get "$l" '.model // empty')"
    cand_set "$l" state ready
    log "candidate $l ready: $(cand_get "$l" '.env_dir')"
  done
  mf_update '.status = "spawned"'
}

cmd_run() {
  detect_layout; mf_require "$1"; shift
  [ -s "$ARENA_DIR/brief.md" ] || die "no brief (ddev ai-arena plan $SLUG)"
  local l prompt env_dir
  prompt="$(sed -e "s|{{SLUG}}|$SLUG|g" -e "s|{{REPO}}|$CONTAINER_REPO|g" "$PROMPTS_DIR/candidate.md")"
  for l in $(resolve_labels "$@"); do
    guard_label "$l"
    case "$(cand_get "$l" '.state')" in ready|DONE|BLOCKED|FAILED|PARTIAL) ;; running) warn "$l already running"; continue ;; *) warn "$l not ready"; continue ;; esac
    env_dir="$(cand_get "$l" '.env_dir')"
    cp "$ARENA_DIR/brief.md" "$env_dir/arena-brief.md"
    launch_candidate "$l" "$prompt" 0
  done
  mf_update '.status = "running"'
}

cmd_resume() {
  detect_layout; mf_require "$1"; shift
  local l="$1" msg="${2:-}"
  guard_label "$l"; [ -n "$msg" ] || die "usage: resume <slug> <label> \"<message>\""
  [ -n "$(cand_get "$l" '.session // empty')" ] || die "candidate $l has no session to resume"
  launch_candidate "$l" "$msg"$'\n\n'"When done, rewrite $CONTAINER_ROOT/arena-report.md (STATUS first line) as before." 1
}

cmd_wait() {
  detect_layout; mf_require "$1"; shift
  local all=0 timeout="$AI_ARENA_TIMEOUT" interval=15 start l st changed
  while [ $# -gt 0 ]; do
    case "$1" in --all) all=1; shift ;; --timeout) timeout="$2"; shift 2 ;; --interval) interval="$2"; shift 2 ;; *) die "unknown option $1" ;; esac
  done
  start="$(date +%s)"
  while :; do
    changed=0
    for l in $(labels); do
      [ "$(cand_get "$l" '.state')" = "running" ] || continue
      st="$(settle_candidate "$l")"
      [ "$st" = "running" ] || { changed=1; log "candidate $l -> $st"; }
    done
    if [ "$changed" = "1" ] && [ "$all" = "0" ]; then break; fi
    if ! jq -e '.candidates[] | select(.state=="running")' "$MANIFEST" >/dev/null; then break; fi
    if [ "$timeout" -gt 0 ] && [ $(( $(date +%s) - start )) -ge "$timeout" ]; then
      status_json; die "timeout after ${timeout}s with candidates still running"
    fi
    sleep "$interval"
  done
  status_json
}

cmd_status() {
  detect_layout; mf_require "$1"; shift
  local l
  for l in $(labels); do [ "$(cand_get "$l" '.state')" = "running" ] && settle_candidate "$l" >/dev/null; done
  if [ "${1:-}" = "--json" ]; then status_json; else echo "arena: $SLUG ($(mf_get '.status'))  task: $(mf_get '.task')"; status_table; fi
}

cmd_pm() {
  detect_layout; mf_require "$1"; shift
  local msg="${1:-}"
  [ -n "$msg" ] || die "usage: pm <slug> \"<message>\""
  pm_call "$msg"
}

cmd_gate() {
  detect_layout; mf_require "$1"; shift
  local l
  for l in $(resolve_labels "$@"); do guard_label "$l"; [ -d "$(cand_get "$l" '.env_dir')" ] || { warn "$l has no environment"; continue; }; gate_candidate "$l"; done
}

cmd_collect() {
  detect_layout; mf_require "$1"; shift
  local l
  for l in $(labels); do [ -d "$(cand_get "$l" '.env_dir')" ] || continue; collect_candidate "$l"; done
  mf_update '.status = "collected"'
}

cmd_judge() {
  detect_layout; mf_require "$1"; shift
  [ -d "$ARENA_DIR/candidates" ] && ls "$ARENA_DIR"/candidates/*/report.md >/dev/null 2>&1 || die "nothing collected (ddev ai-arena collect $SLUG)"
  local msg out
  msg="$(sed -e "s|{{SLUG}}|$SLUG|g" -e "s|{{ARENA}}|$CONTAINER_ARENA|g" -e "s|{{REPO}}|$CONTAINER_REPO|g" "$PROMPTS_DIR/judge.md")"
  msg="${msg//\{\{CANDIDATES\}\}/$(labels | tr '\n' ' ')}"
  out="$(pm_call "$msg")"
  mf_update --argjson j "$out" '.judge = $j | .status = "judged"'
  printf '%s\n' "$out"
}

cmd_promote() {
  detect_layout; mf_require "$1"; shift
  local l="$1"; shift; guard_label "$l"
  local target="feature/$SLUG" env=0
  while [ $# -gt 0 ]; do case "$1" in --branch) target="$2"; shift 2 ;; --env) env=1; shift ;; *) die "unknown option $1" ;; esac; done
  local src; src="$(cand_get "$l" '.branch')"
  git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$src" || die "branch $src does not exist"
  if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$target"; then die "branch $target already exists"; fi
  git -C "$REPO_DIR" branch "$target" "$src"
  mf_update --arg w "$l" --arg t "$target" '.winner = {label:$w, branch:$t} | .status = "promoted"'
  log "created $target from $src (candidate $l)"
  if [ "$env" = "1" ]; then
    local env_name="${SITENAME}-$(printf '%s' "$target" | tr '/' '-')" env_dir="$ENV_PARENT/${SITENAME}-$(printf '%s' "$target" | tr '/' '-')"
    create_env "$target" "$env_name" "$env_dir" "winner" "" ""
    log "environment ready: $env_dir"
  fi
}

cmd_reveal() {
  detect_layout; mf_require "$1"; shift
  local winner; winner="$(mf_get '.winner.label // .judge.winner // empty')"
  echo "arena: $SLUG   winner: ${winner:-(none yet)}"
  printf '%-6s %-9s %s\n' LABEL HARNESS MODEL
  jq -r '.candidates[] | [.label, .harness, (.model // "(default)")] | @tsv' "$MANIFEST" | while IFS=$'\t' read -r l h m; do printf '%-6s %-9s %s\n' "$l" "$h" "$m"; done
  if [ -n "$winner" ]; then
    mkdir -p "$(dirname "$WINS_LOG")"
    [ -f "$WINS_LOG" ] || printf 'ts\tproject\tslug\twinner\tharness\tmodel\tcandidates\n' > "$WINS_LOG"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(now)" "$SITENAME" "$SLUG" "$winner" \
      "$(cand_get "$winner" '.harness')" "$(cand_get "$winner" '.model // "(default)"')" \
      "$(jq -r '[.candidates[] | .harness + ":" + (.model // "default")] | join(",")' "$MANIFEST")" >> "$WINS_LOG"
    log "logged to $WINS_LOG"
  fi
}

cmd_clean() {
  detect_layout; mf_require "$1"; shift
  local keep="" purge=0 l winner
  while [ $# -gt 0 ]; do case "$1" in --keep) keep="$2"; shift 2 ;; --purge) purge=1; shift ;; *) die "unknown option $1" ;; esac; done
  winner="$(mf_get '.winner.label // empty')"
  for l in $(labels); do
    local keep_branch=0
    { [ "$l" = "$keep" ] || [ "$l" = "$winner" ]; } && keep_branch=1
    if [ "$(cand_get "$l" '.state')" = "running" ]; then warn "candidate $l is still running; skipping (stop it first)"; continue; fi
    if [ -d "$(cand_get "$l" '.env_dir')" ] || git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$(cand_get "$l" '.branch')"; then
      remove_env "$(cand_get "$l" '.env_name')" "$(cand_get "$l" '.env_dir')" "$(cand_get "$l" '.branch')" "$keep_branch"
    fi
    cand_set "$l" state cleaned
  done
  mf_update '.status = "cleaned"'
  [ "$purge" = "1" ] && { rm -rf "$ARENA_DIR"; log "purged $ARENA_DIR"; }
  return 0
}

cmd_list() {
  detect_layout
  local m
  shopt -s nullglob
  for m in "$APPROOT"/arena/*/manifest.json; do
    jq -r '"\(.slug)\t\(.status)\t\(.candidates | length) candidates\t\(.task)"' "$m"
  done
  shopt -u nullglob
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
need git; need jq; need ddev; need docker
cmd="${1:-}"; shift || true
case "$cmd" in
  doctor)  cmd_doctor ;;
  init)    cmd_init "$@" ;;
  plan)    cmd_plan "$@" ;;
  spawn)   cmd_spawn "$@" ;;
  run)     cmd_run "$@" ;;
  wait)    cmd_wait "$@" ;;
  status)  cmd_status "$@" ;;
  resume)  cmd_resume "$@" ;;
  pm)      cmd_pm "$@" ;;
  gate)    cmd_gate "$@" ;;
  collect) cmd_collect "$@" ;;
  judge)   cmd_judge "$@" ;;
  promote) cmd_promote "$@" ;;
  reveal)  cmd_reveal "$@" ;;
  clean)   cmd_clean "$@" ;;
  list)    cmd_list ;;
  ""|-h|--help|help) usage ;;
  --version) echo "$VERSION" ;;
  *) die "unknown command '$cmd' (see ddev ai-arena --help)" ;;
esac
